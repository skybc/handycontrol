        BasedOn="{StaticResource SGammaLightButtonBaseStyle}"
        TargetType="Button">
        <Setter Property="Width" Value="{StaticResource DefaultControlHeight}" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" />
