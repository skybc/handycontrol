        <Setter Property="Background" Value="#FFFFFFFF" />
        <Setter Property="RowHeight" Value="40" />
        <Setter Property="RowStyle" Value="{StaticResource SGammaLightDataGridRow}" />
        <Setter Property="ColumnHeaderHeight" Value="32" />
        <Setter Property="ColumnHeaderStyle" Value="{StaticResource SGammaLightDataGridHeader}" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontFamily" Value="Microsoft YaHei, Segoe UI" />
        <Setter Property="hc:BorderElement.CornerRadius" Value="{StaticResource DefaultCornerRadius}" />
    </Style>
    <Style BasedOn="{StaticResource ListViewBaseStyle}" TargetType="ListView">
        <Setter Property="Background" Value="#FFFFFFFF" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontFamily" Value="Microsoft YaHei, Segoe UI" />
    </Style>
    <Style
        x:Key="SGammaLightTreeViewItemStyle"
        BasedOn="{StaticResource BaseStyle}"
        TargetType="TreeViewItem">
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisualRadius0Margin0}" />
        <Setter Property="FontSize" Value="{StaticResource TreeViewFontSize}" />
        <Setter Property="Background" Value="{DynamicResource TreeViewBaseBackgroundToken1}" />
        <Setter Property="Padding" Value="{StaticResource TreeViewItemPadding}" />
        <Setter Property="BorderThickness" Value="{StaticResource TreeViewBaseBorderThicknessToken1}" />
        <Setter Property="BorderBrush" Value="{DynamicResource RegionBrush}" />
        <Setter Property="MinHeight" Value="{StaticResource ListRowHeight}" />
        <Setter Property="Margin" Value="{StaticResource TreeViewBaseMarginToken1}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TreeViewItem">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition MinHeight="{TemplateBinding MinHeight}" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Border
                            x:Name="Bd"
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{Binding Path=(hc:BorderElement.CornerRadius), RelativeSource={RelativeSource TemplatedParent}}"
                            SnapsToDevicePixels="true">
                            <DockPanel Margin="{Binding Converter={StaticResource TreeViewItemMarginConverter}, ConverterParameter={StaticResource TreeViewItemIndent}, RelativeSource={RelativeSource TemplatedParent}}" LastChildFill="True">
                                <ToggleButton
                                    x:Name="Expander"
                                    ClickMode="Release"
                                    IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}"
                                    Style="{StaticResource ExpandCollapseToggleStyle}" />
                                <ContentPresenter
                                    x:Name="PART_Header"
                                    VerticalAlignment="Center"
                                    ContentSource="Header"
                                    SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                            </DockPanel>
                        </Border>
                        <ItemsPresenter x:Name="ItemsHost" Grid.Row="1" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger SourceName="Bd" Property="IsMouseOver" Value="true">
                            <Setter TargetName="Bd" Property="Background" Value="#FFF1F5F9" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="#FFF1F5F9" />
                        </Trigger>
                        <Trigger Property="IsExpanded" Value="false">
                            <Setter TargetName="ItemsHost" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="HasItems" Value="false">
                            <Setter TargetName="Expander" Property="Visibility" Value="Hidden" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="true">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource LightPrimaryBrush}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
                            <Setter TargetName="Bd" Property="BorderThickness" Value="3,0,0,0" />
                            <Setter Property="hc:BorderElement.CornerRadius" Value="{StaticResource TreeViewBaseCornerRadiusToken1}" />
                            <Setter Property="Foreground" Value="{DynamicResource DarkPrimaryBrush}" />
                        </Trigger>
                        <DataTrigger Binding="{Binding IsSelected}" Value="true">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource LightPrimaryBrush}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
                            <Setter TargetName="Bd" Property="BorderThickness" Value="3,0,0,0" />
                            <Setter Property="hc:BorderElement.CornerRadius" Value="{StaticResource TreeViewBaseCornerRadiusToken1}" />
                            <Setter Property="Foreground" Value="{DynamicResource DarkPrimaryBrush}" />
                        </DataTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsSelected" Value="true" />
                                <Condition Property="IsSelectionActive" Value="false" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource LightPrimaryBrush}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
                            <Setter TargetName="Bd" Property="BorderThickness" Value="3,0,0,0" />
                            <Setter Property="hc:BorderElement.CornerRadius" Value="{StaticResource TreeViewBaseCornerRadiusToken1}" />
                            <Setter Property="Foreground" Value="{DynamicResource DarkPrimaryBrush}" />

                        </MultiTrigger>
                        <Trigger Property="IsEnabled" Value="false">
                            <Setter Property="Opacity" Value=".4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style BasedOn="{StaticResource TreeViewBaseStyle}" TargetType="TreeView">
        <Setter Property="Background" Value="#FFFFFFFF" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontFamily" Value="Microsoft YaHei, Segoe UI" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource SGammaLightTreeViewItemStyle}" />
    </Style>
    <Style BasedOn="{StaticResource MenuBaseStyle}" TargetType="Menu">
        <Setter Property="Background" Value="#FFFFFFFF" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontFamily" Value="Microsoft YaHei, Segoe UI" />
    </Style>
    <Style BasedOn="{StaticResource ContextMenuBaseStyle}" TargetType="ContextMenu">
        <Setter Property="Background" Value="#FFFFFFFF" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontFamily" Value="Microsoft YaHei, Segoe UI" />
    </Style>

    <!--  Narrow inspector: 96px labels, 32px rows, grouped and scrollable content.  -->
    <Style x:Key="SGammaLightPropertyItemStyle" TargetType="hc:PropertyItem">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="hc:PropertyItem">
                    <Grid MinHeight="32">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="96" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border
                            Background="{DynamicResource SecondaryRegionBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="0,0,1,1">
                            <TextBlock
                                Margin="10,0,8,0"
                                VerticalAlignment="Center"
                                FontSize="12"
                                Foreground="{DynamicResource SecondaryTextBrush}"
                                Text="{TemplateBinding DisplayName}"
                                TextTrimming="CharacterEllipsis" />
                        </Border>
                        <Border
                            Grid.Column="1"
                            Padding="0,0"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="0,0,0,1">
                            <ContentPresenter VerticalAlignment="Center" ContentSource="EditorElement" />
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="SGammaLightPropertyItemsControlStyle" TargetType="hc:PropertyItemsControl">
        <Setter Property="ItemContainerStyle" Value="{StaticResource SGammaLightPropertyItemStyle}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="hc:PropertyItemsControl">
                    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                        <ItemsPresenter />
                    </ScrollViewer>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="SGammaLightPropertyGroupStyle" TargetType="GroupItem">
        <Setter Property="Margin" Value="0,4,0,0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="GroupItem">
                    <Expander
                        Background="{DynamicResource RegionBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        IsExpanded="True">
                        <Expander.Header>
                            <TextBlock
                                Padding="8,4"
                                FontSize="12"
                                FontWeight="SemiBold"
                                Foreground="{DynamicResource PrimaryTextBrush}"
                                Text="{Binding Name}" />
                        </Expander.Header>
                        <Border
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1,0,1,1"
                            CornerRadius="0">
                            <ItemsPresenter />
                        </Border>
                    </Expander>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="hc:PropertyGrid">
        <Setter Property="MaxTitleWidth" Value="200" />
        <Setter Property="MinTitleWidth" Value="60" />
        <Setter Property="Padding" Value="4" />
        <Setter Property="Background" Value="{DynamicResource RegionBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="hc:PropertyGrid">
                    <Border
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{StaticResource SGammaLightLargeCornerRadius}">
                        <Grid Margin="{TemplateBinding Padding}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <DockPanel Margin="0,0,0,8" LastChildFill="True">
                                <hc:ButtonGroup Margin="0,0,8,0" Style="{DynamicResource ButtonGroupSolid}"
                                    Visibility="{Binding ShowSortButton, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource Boolean2VisibilityConverter}}">
                                    <RadioButton Command="interactivity:ControlCommands.SortByCategory"
                                        IsChecked="{Binding IsCategorized, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}">
                                        <Rectangle Width="16" Height="16" Fill="{DynamicResource SortByCategoryDrawingBrush}" />
                                    </RadioButton>
                                    <RadioButton Command="interactivity:ControlCommands.SortByName"
                                        IsChecked="{Binding IsCategorized, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay, Converter={StaticResource Boolean2BooleanReConverter}}">
                                        <Rectangle Width="16" Height="16" Fill="{DynamicResource SortByNameDrawingBrush}" />
                                    </RadioButton>
                                </hc:ButtonGroup>
                                <hc:SearchBar
                                    x:Name="PART_SearchBar"
                                    MinHeight="32"
                                    hc:InfoElement.ShowClearButton="True"
                                    IsRealTime="True"
                                    Text="{Binding SearchText, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    Visibility="{Binding ShowSearchBar, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource Boolean2VisibilityConverter}}" />
                            </DockPanel>
                            <hc:PropertyItemsControl
                                x:Name="PART_ItemsControl"
                                Grid.Row="1"
                                Style="{StaticResource SGammaLightPropertyItemsControlStyle}">
                                <hc:PropertyItemsControl.GroupStyle>
                                    <GroupStyle ContainerStyle="{StaticResource SGammaLightPropertyGroupStyle}" />
                                </hc:PropertyItemsControl.GroupStyle>
                            </hc:PropertyItemsControl>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Context-specific variants do not impose page layout on every control. -->
    <Style x:Key="SGammaLightDenseDataGrid" BasedOn="{StaticResource {x:Type DataGrid}}" TargetType="DataGrid">
        <Setter Property="RowHeight" Value="32" />
    </Style>
    <Style x:Key="SGammaLightTableTextBox" BasedOn="{StaticResource {x:Type TextBox}}" TargetType="TextBox">
        <Setter Property="Padding" Value="8,0" />
    </Style>
    <Style x:Key="SGammaLightTableNumberTextBox" BasedOn="{StaticResource SGammaLightTableTextBox}" TargetType="TextBox">
        <Setter Property="TextAlignment" Value="Right" />
    </Style>
    <Style x:Key="SGammaLightTableComboBox" BasedOn="{StaticResource {x:Type ComboBox}}" TargetType="ComboBox">
        <Setter Property="Padding" Value="8,0" />
    </Style>
    <Style x:Key="SGammaLightDialogButton" BasedOn="{StaticResource ButtonDefault}" TargetType="Button">
        <Setter Property="Padding" Value="16,0" />
        <Setter Property="hc:BorderElement.CornerRadius" Value="6" />
    </Style>
    <Style x:Key="SGammaLightDialogPrimaryButton" BasedOn="{StaticResource ButtonPrimary}" TargetType="Button">
        <Setter Property="Padding" Value="16,0" />
        <Setter Property="hc:BorderElement.CornerRadius" Value="6" />
    </Style>
    <Style x:Key="SGammaLightSwitch" TargetType="ToggleButton">
        <Setter Property="Width" Value="40" />
        <Setter Property="Height" Value="20" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource SGammaLightButtonFocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Track" Background="#FFCBD5E1" CornerRadius="10">
                        <Ellipse x:Name="Thumb" Width="16" Height="16" Margin="2" Fill="White" HorizontalAlignment="Left" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="#FF2563EB" />
                            <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="SGammaLightTabItem" TargetType="TabItem">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontFamily" Value="Microsoft YaHei, Segoe UI" />
        <Setter Property="Padding" Value="16,0" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource SGammaLightButtonFocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Border x:Name="Panel" Background="White" BorderBrush="#FF2563EB" BorderThickness="0" Padding="{TemplateBinding Padding}">
                        <ContentPresenter ContentSource="Header" VerticalAlignment="Center" HorizontalAlignment="Center" RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Panel" Property="Background" Value="#FFF1F5F9" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Panel" Property="Background" Value="#FFEFF6FF" />
                            <Setter TargetName="Panel" Property="BorderThickness" Value="0,0,0,3" />
                            <Setter Property="Foreground" Value="#FF1D4ED8" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="#FF94A3B8" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style BasedOn="{StaticResource TabControlBaseStyle}" TargetType="TabControl">
        <Setter Property="Foreground" Value="#FF0F172A" />
        <Setter Property="Background" Value="#FFFFFFFF" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource SGammaLightTabItem}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontFamily" Value="Microsoft YaHei, Segoe UI" />
    </Style>
    <system:Double x:Key="SGammaLightDialogSmallWidth">480</system:Double>
    <system:Double x:Key="SGammaLightDialogSmallHeight">300</system:Double>
    <system:Double x:Key="SGammaLightDialogMediumWidth">640</system:Double>
    <system:Double x:Key="SGammaLightDialogMediumHeight">480</system:Double>
    <system:Double x:Key="SGammaLightDialogLargeWidth">960</system:Double>
    <system:Double x:Key="SGammaLightDialogLargeHeight">680</system:Double>

    <Style x:Key="ToggleButtonSwitch" BasedOn="{StaticResource SGammaLightSwitch}" TargetType="ToggleButton" />
</ResourceDictionary>
