<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:hc="clr-namespace:HandyControl.Controls"
    xmlns:system="clr-namespace:System;assembly=mscorlib">
    <!--  Layout tokens are intentionally local to this skin.  Existing skins retain their sizes.  -->
    <system:Double x:Key="DefaultControlHeight">32</system:Double>
    <system:Double x:Key="MiddleControlHeight">28</system:Double>
    <system:Double x:Key="SmallControlHeight">24</system:Double>
    <Thickness x:Key="DefaultControlPadding">12,4</Thickness>
    <Thickness x:Key="DefaultInputPadding">10,0</Thickness>
    <CornerRadius x:Key="DefaultCornerRadius">4</CornerRadius>
    <CornerRadius x:Key="StandardLightLargeCornerRadius">6</CornerRadius>
    <CornerRadius x:Key="StandardLightPanelCornerRadius">10</CornerRadius>
    <system:Double x:Key="StandardLightBodyFontSize">14</system:Double>
    <system:Double x:Key="StandardLightAssistFontSize">12</system:Double>
    <system:Double x:Key="StandardLightLargeControlHeight">40</system:Double>

    <SolidColorBrush x:Key="StandardLightButtonHoverBorderBrush" Color="#FF94A3B8" />
    <SolidColorBrush x:Key="StandardLightButtonPressedBorderBrush" Color="#FF64748B" />
    <SolidColorBrush x:Key="StandardLightButtonPressedBackgroundBrush" Color="#FFE2E8F0" />
    <SolidColorBrush x:Key="StandardLightButtonPressedPrimaryBrush" Color="#FF1E40AF" />
    <SolidColorBrush x:Key="StandardLightButtonPressedDangerBrush" Color="#FF991B1B" />
    <SolidColorBrush x:Key="StandardLightButtonTextPressedBrush" Color="#FF1E3A8A" />
    <SolidColorBrush x:Key="StandardLightButtonIconBrush" Color="#FF475569" />
    <SolidColorBrush x:Key="StandardLightButtonIconHoverBrush" Color="#FF334155" />
    <SolidColorBrush x:Key="StandardLightButtonIconPressedBrush" Color="#FF1E293B" />
    <SolidColorBrush x:Key="StandardLightButtonFocusBrush" Color="#662563EB" />

    <Style x:Key="StandardLightButtonFocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle
                        Margin="-2"
                        RadiusX="6"
                        RadiusY="6"
                        SnapsToDevicePixels="True"
                        Stroke="{StaticResource StandardLightButtonFocusBrush}"
                        StrokeThickness="2" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        The base theme intentionally uses gradients. StandardLight keeps semantic
        resource keys but makes every action and feedback brush a solid color.
    -->
    <Style
        x:Key="StandardLightButtonBaseStyle"
        BasedOn="{StaticResource ButtonBaseBaseStyle}"
        TargetType="Button">
        <Setter Property="Height" Value="{StaticResource DefaultControlHeight}" />
        <Setter Property="Padding" Value="16,4" />
        <Setter Property="FontSize" Value="{StaticResource StandardLightBodyFontSize}" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
        <Setter Property="Background" Value="{DynamicResource RegionBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SecondaryBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="hc:BorderElement.CornerRadius" Value="{StaticResource StandardLightLargeCornerRadius}" />
        <Setter Property="hc:IconElement.Width" Value="16" />
        <Setter Property="hc:IconElement.Height" Value="16" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource StandardLightButtonFocusVisual}" />
        <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <hc:SimplePanel>
                        <Border Background="{TemplateBinding Background}" CornerRadius="{Binding Path=(hc:BorderElement.CornerRadius), RelativeSource={RelativeSource TemplatedParent}}" />
                        <Border
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{Binding Path=(hc:BorderElement.CornerRadius), RelativeSource={RelativeSource TemplatedParent}}">
                            <StackPanel
                                Margin="{TemplateBinding Padding}"
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                Orientation="Horizontal">
                                <Path
                                    x:Name="PathMain"
                                    Width="{TemplateBinding hc:IconElement.Width}"
                                    Height="{TemplateBinding hc:IconElement.Height}"
                                    Data="{TemplateBinding hc:IconElement.Geometry}"
                                    Fill="{TemplateBinding Foreground}"
                                    SnapsToDevicePixels="True"
                                    Stretch="Uniform" />
                                <ContentPresenter
                                    x:Name="ContentPresenterMain"
                                    Margin="8,0,0,0"
                                    VerticalAlignment="Center"
                                    RecognizesAccessKey="True"
                                    SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                            </StackPanel>
                        </Border>
                    </hc:SimplePanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Content" Value="{x:Null}">
                            <Setter TargetName="ContentPresenterMain" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="hc:IconElement.Geometry" Value="{x:Null}">
                            <Setter TargetName="PathMain" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="ContentPresenterMain" Property="Margin" Value="0" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style
        x:Key="ButtonDefault"
        BasedOn="{StaticResource StandardLightButtonBaseStyle}"
        TargetType="Button">
        <Setter Property="Foreground" Value="#FF334155" />
        <Setter Property="Background" Value="#FFFFFFFF" />
        <Setter Property="BorderBrush" Value="#FFCBD5E1" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Opacity" Value="1" />
                <Setter Property="Background" Value="#FFF1F5F9" />
                <Setter Property="BorderBrush" Value="{StaticResource StandardLightButtonHoverBorderBrush}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Opacity" Value="1" />
                <Setter Property="Background" Value="{StaticResource StandardLightButtonPressedBackgroundBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource StandardLightButtonPressedBorderBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="1" />
                <Setter Property="Background" Value="#FFF1F5F9" />
                <Setter Property="Foreground" Value="#FF94A3B8" />
                <Setter Property="BorderBrush" Value="#FFF1F5F9" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style
        x:Key="ButtonPrimary"
        BasedOn="{StaticResource StandardLightButtonBaseStyle}"
        TargetType="Button">
        <Setter Property="Foreground" Value="#FFFFFFFF" />
        <Setter Property="Background" Value="#FF2563EB" />
        <Setter Property="BorderBrush" Value="#FF2563EB" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Opacity" Value="1" />
                <Setter Property="Background" Value="#FF1D4ED8" />
                <Setter Property="BorderBrush" Value="#FF1D4ED8" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Opacity" Value="1" />
                <Setter Property="Background" Value="{StaticResource StandardLightButtonPressedPrimaryBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource StandardLightButtonPressedPrimaryBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="1" />
                <Setter Property="Background" Value="#FFF1F5F9" />
                <Setter Property="Foreground" Value="#FF94A3B8" />
                <Setter Property="BorderBrush" Value="#FFF1F5F9" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style
        x:Key="ButtonDanger"
        BasedOn="{StaticResource StandardLightButtonBaseStyle}"
        TargetType="Button">
        <Setter Property="Foreground" Value="#FFFFFFFF" />
        <Setter Property="Background" Value="#FFDC2626" />
        <Setter Property="BorderBrush" Value="#FFDC2626" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Opacity" Value="1" />
                <Setter Property="Background" Value="#FFB91C1C" />
                <Setter Property="BorderBrush" Value="#FFB91C1C" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Opacity" Value="1" />
                <Setter Property="Background" Value="{StaticResource StandardLightButtonPressedDangerBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource StandardLightButtonPressedDangerBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="1" />
                <Setter Property="Background" Value="#FFF1F5F9" />
                <Setter Property="Foreground" Value="#FF94A3B8" />
                <Setter Property="BorderBrush" Value="#FFF1F5F9" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style
        x:Key="ButtonText"
        BasedOn="{StaticResource StandardLightButtonBaseStyle}"
        TargetType="Button">
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="#FF1D4ED8" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Opacity" Value="1" />
                <Setter Property="Foreground" Value="#FF1E40AF" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Opacity" Value="1" />
                <Setter Property="Foreground" Value="{StaticResource StandardLightButtonTextPressedBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="1" />
                <Setter Property="Background" Value="#FFF1F5F9" />
                <Setter Property="Foreground" Value="#FF94A3B8" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style
        x:Key="ButtonIcon"
        BasedOn="{StaticResource StandardLightButtonBaseStyle}"
        TargetType="Button">
        <Setter Property="Width" Value="{StaticResource DefaultControlHeight}" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{StaticResource StandardLightButtonIconBrush}" />
        <Setter Property="hc:IconElement.Width" Value="20" />
        <Setter Property="hc:IconElement.Height" Value="20" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{Binding Path=(hc:BorderElement.CornerRadius), RelativeSource={RelativeSource TemplatedParent}}">
                        <ContentControl
                            Margin="{TemplateBinding Padding}"
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                            SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}">
                            <Path
                                Width="{TemplateBinding hc:IconElement.Width}"
                                Height="{TemplateBinding hc:IconElement.Height}"
                                Data="{TemplateBinding hc:IconElement.Geometry}"
                                Fill="{TemplateBinding Foreground}"
                                SnapsToDevicePixels="True"
                                Stretch="Uniform" />
                        </ContentControl>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#FFF1F5F9" />
                            <Setter Property="Foreground" Value="{StaticResource StandardLightButtonIconHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Background" Value="{StaticResource StandardLightButtonPressedBackgroundBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource StandardLightButtonIconPressedBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Background" Value="#FFF1F5F9" />
                            <Setter Property="Foreground" Value="#FF94A3B8" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Opacity" Value="1" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Opacity" Value="1" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="1" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="ButtonDefault.Large" BasedOn="{StaticResource ButtonDefault}" TargetType="Button">
        <Setter Property="Height" Value="{StaticResource StandardLightLargeControlHeight}" />
    </Style>
    <Style x:Key="ButtonPrimary.Large" BasedOn="{StaticResource ButtonPrimary}" TargetType="Button">
        <Setter Property="Height" Value="{StaticResource StandardLightLargeControlHeight}" />
    </Style>
    <Style x:Key="ButtonDanger.Large" BasedOn="{StaticResource ButtonDanger}" TargetType="Button">
        <Setter Property="Height" Value="{StaticResource StandardLightLargeControlHeight}" />
    </Style>
    <Style x:Key="ButtonText.Large" BasedOn="{StaticResource ButtonText}" TargetType="Button">
        <Setter Property="Height" Value="{StaticResource StandardLightLargeControlHeight}" />
    </Style>
    <Style x:Key="ButtonIcon.Large" BasedOn="{StaticResource ButtonIcon}" TargetType="Button">
        <Setter Property="Height" Value="{StaticResource StandardLightLargeControlHeight}" />
        <Setter Property="Width" Value="{StaticResource StandardLightLargeControlHeight}" />
    </Style>

    <Style BasedOn="{StaticResource ButtonDefault}" TargetType="Button" />
    <Style BasedOn="{StaticResource TextBoxBaseStyle}" TargetType="TextBox">
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="FontSize" Value="14" />
    </Style>
    <Style BasedOn="{StaticResource PasswordBoxBaseStyle}" TargetType="PasswordBox">
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="FontSize" Value="14" />
    </Style>
    <Style BasedOn="{StaticResource ComboBoxBaseStyle}" TargetType="ComboBox">
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="FontSize" Value="14" />
    </Style>
    <Style BasedOn="{StaticResource CheckBoxBaseStyle}" TargetType="CheckBox">
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="FontSize" Value="14" />
    </Style>
    <Style BasedOn="{StaticResource RadioButtonBaseStyle}" TargetType="RadioButton">
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="FontSize" Value="14" />
    </Style>
    <Style BasedOn="{StaticResource NumericUpDownBaseStyle}" TargetType="hc:NumericUpDown">
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="FontSize" Value="14" />
    </Style>
    <Style BasedOn="{StaticResource CardBaseStyle}" TargetType="hc:Card">
        <Setter Property="Padding" Value="16" />
        <Setter Property="hc:BorderElement.CornerRadius" Value="{StaticResource StandardLightPanelCornerRadius}" />
    </Style>
    <Style BasedOn="{StaticResource DataGridBaseStyle}" TargetType="DataGrid">
        <Setter Property="Background" Value="#FFFFFFFF" />
        <Setter Property="RowHeight" Value="{DynamicResource ListRowHeight}" />
        <Setter Property="ColumnHeaderHeight" Value="32" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="hc:BorderElement.CornerRadius" Value="{StaticResource StandardLightLargeCornerRadius}" />
    </Style>
    <Style BasedOn="{StaticResource ListViewBaseStyle}" TargetType="ListView">
        <Setter Property="FontSize" Value="14" />
    </Style>
    <Style BasedOn="{StaticResource TreeViewBaseStyle}" TargetType="TreeView">
        <Setter Property="FontSize" Value="{DynamicResource TreeViewFontSize}" />
    </Style>
    <Style BasedOn="{StaticResource MenuBaseStyle}" TargetType="Menu">
        <Setter Property="FontSize" Value="14" />
    </Style>
    <Style BasedOn="{StaticResource ContextMenuBaseStyle}" TargetType="ContextMenu">
        <Setter Property="FontSize" Value="14" />
    </Style>

    <!--  Narrow inspector: 96px labels, 32px rows, grouped and scrollable content.  -->
    <Style x:Key="StandardLightPropertyItemStyle" TargetType="hc:PropertyItem">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="hc:PropertyItem">
                    <Grid MinHeight="32">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="96" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border
                            Background="{DynamicResource SecondaryRegionBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="0,0,1,1">
                            <TextBlock
                                Margin="10,0,8,0"
                                VerticalAlignment="Center"
                                FontSize="12"
                                Foreground="{DynamicResource SecondaryTextBrush}"
                                Text="{TemplateBinding DisplayName}"
                                TextTrimming="CharacterEllipsis" />
                        </Border>
                        <Border
                            Grid.Column="1"
                            Padding="0,0"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="0,0,0,1">
                            <ContentPresenter VerticalAlignment="Center" ContentSource="EditorElement" />
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="StandardLightPropertyItemsControlStyle" TargetType="hc:PropertyItemsControl">
        <Setter Property="ItemContainerStyle" Value="{StaticResource StandardLightPropertyItemStyle}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="hc:PropertyItemsControl">
                    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                        <ItemsPresenter />
                    </ScrollViewer>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="StandardLightPropertyGroupStyle" TargetType="GroupItem">
        <Setter Property="Margin" Value="0,4,0,0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="GroupItem">
                    <Expander
                        Background="{DynamicResource RegionBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        IsExpanded="True">
                        <Expander.Header>
                            <TextBlock
                                Padding="8,4"
                                FontSize="12"
                                FontWeight="SemiBold"
                                Foreground="{DynamicResource PrimaryTextBrush}"
                                Text="{Binding Name}" />
                        </Expander.Header>
                        <Border
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1,0,1,1"
                            CornerRadius="0">
                            <ItemsPresenter />
                        </Border>
                    </Expander>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="hc:PropertyGrid">
        <Setter Property="MaxTitleWidth" Value="200" />
        <Setter Property="MinTitleWidth" Value="60" />
        <Setter Property="Padding" Value="4" />
        <Setter Property="Background" Value="{DynamicResource RegionBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="hc:PropertyGrid">
                    <Border
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{StaticResource StandardLightLargeCornerRadius}">
                        <Grid Margin="{TemplateBinding Padding}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <hc:SearchBar
                                x:Name="PART_SearchBar"
                                MinHeight="32"
                                Margin="0,0,0,8"
                                hc:InfoElement.ShowClearButton="True"
                                IsRealTime="True"
                                Visibility="{Binding ShowSearchBar, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource Boolean2VisibilityConverter}}" />
                            <hc:PropertyItemsControl
                                x:Name="PART_ItemsControl"
                                Grid.Row="1"
                                Style="{StaticResource StandardLightPropertyItemsControlStyle}">
                                <hc:PropertyItemsControl.GroupStyle>
                                    <GroupStyle ContainerStyle="{StaticResource StandardLightPropertyGroupStyle}" />
                                </hc:PropertyItemsControl.GroupStyle>
                            </hc:PropertyItemsControl>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
