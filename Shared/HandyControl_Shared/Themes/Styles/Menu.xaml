<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style BasedOn="{StaticResource MenuItemBaseStyle}" TargetType="MenuItem" />

    <Style BasedOn="{StaticResource MenuBaseStyle}" TargetType="Menu" />

    <Style x:Key="Menu.Small" BasedOn="{StaticResource MenuBaseStyle}" TargetType="Menu">
        <Setter Property="hc:MenuAttach.ItemPadding" Value="{StaticResource MenuStyleItemPaddingToken1}" />
        <Setter Property="hc:MenuAttach.PopupVerticalOffset" Value="{StaticResource MenuStylePopupVerticalOffsetToken2}" />
        <Setter Property="hc:MenuAttach.PopupHorizontalOffset" Value="{StaticResource MenuStylePopupHorizontalOffsetToken2}" />
    </Style>

</ResourceDictionary>
