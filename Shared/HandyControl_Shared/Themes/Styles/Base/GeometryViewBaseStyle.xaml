<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:hc="clr-namespace:HandyControl.Controls">

    <Style x:Key="GeometryViewBaseStyle" BasedOn="{StaticResource BaseStyle}" TargetType="hc:GeometryView">
        <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
        <Setter Property="FontSize" Value="{StaticResource GeometryViewBaseFontSizeToken1}"/>
        <Setter Property="Stretch" Value="Uniform"/>
        <Setter Property="Background" Value="{DynamicResource GeometryViewBaseBackgroundToken1}"/>
        <Setter Property="Height" Value="{StaticResource GeometryViewBaseHeightToken1}"/>
        <Setter Property="Width" Value="{StaticResource GeometryViewBaseWidthToken1}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="hc:GeometryView">
                    <Grid Background="{TemplateBinding Background}"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style BasedOn="{StaticResource GeometryViewBaseStyle}" TargetType="hc:GeometryView"/>

</ResourceDictionary>
