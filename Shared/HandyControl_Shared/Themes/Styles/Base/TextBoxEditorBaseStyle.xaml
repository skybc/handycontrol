<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:hc="clr-namespace:HandyControl.Controls"
                    xmlns:interactivity="clr-namespace:HandyControl.Interactivity">

    <Style x:Key="TextBoxEditorBaseStyle" TargetType="hc:TextBoxEditor">
        <Setter Property="Background" Value="{DynamicResource RegionBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
        <Setter Property="BorderThickness" Value="{StaticResource TextBoxEditorBaseBorderThicknessToken1}"/>
        <Setter Property="hc:BorderElement.CornerRadius" Value="{StaticResource DefaultCornerRadius}"/>
        <Setter Property="MinHeight" Value="{DynamicResource DefaultControlHeight}"/>
        <Setter Property="Padding" Value="{StaticResource TextBoxEditorBasePaddingToken1}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="IsReadOnly" Value="True"/>
        <Setter Property="EditorButtonText" Value="..."/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="hc:TextBoxEditor">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Border x:Name="border"
                                Grid.Column="0"
                                Grid.ColumnSpan="2"
                                CornerRadius="{Binding Path=(hc:BorderElement.CornerRadius), RelativeSource={RelativeSource TemplatedParent}}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Background="{TemplateBinding Background}"
                                SnapsToDevicePixels="True"/>

                        <TextBox x:Name="PART_TextBox"
                                 Grid.Column="0"
                                 Text="{Binding Text, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                 IsReadOnly="{TemplateBinding IsReadOnly}"
                                 BorderThickness="{StaticResource TextBoxEditorBaseBorderThicknessToken2}"
                                 Background="{DynamicResource TextBoxEditorBaseBackgroundToken1}"
                                 Padding="{TemplateBinding Padding}"
                                 VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                 HorizontalContentAlignment="Stretch"
                                 VerticalScrollBarVisibility="Hidden"
                                 HorizontalScrollBarVisibility="Hidden"/>

                        <Button x:Name="PART_EditorButton"
                                Grid.Column="1"
                                Content="{TemplateBinding EditorButtonText}"
                                Style="{StaticResource ButtonDefault}"
                                Padding="{StaticResource TextBoxEditorBasePaddingToken1}"
                                Margin="{StaticResource TextBoxEditorBaseMarginToken1}"
                                MinWidth="{StaticResource TextBoxEditorBaseMinWidthToken1}"
                                BorderThickness="{StaticResource TextBoxEditorBaseBorderThicknessToken2}"
                                Background="{DynamicResource TextBoxEditorBaseBackgroundToken1}"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="border" Property="Opacity" Value="0.4"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource SecondaryBorderBrush}"/>
                        </Trigger>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
