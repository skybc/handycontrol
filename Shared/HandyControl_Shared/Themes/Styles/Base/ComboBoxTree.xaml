<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:hc="clr-namespace:HandyControl.Controls">

    <Style TargetType="hc:ComboBoxTree">
        <Setter Property="Height" Value="20" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="hc:ComboBoxTree">
                    <Grid
                        x:Name="ParentPanel"
                        Height="{TemplateBinding Height}"
                        ClipToBounds="False">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="20" />
                        </Grid.ColumnDefinitions>

                        <Popup
                            Grid.Column="2"
                            Width="{TemplateBinding Width}"
                            MinHeight="50"
                            IsOpen="{Binding IsChecked, ElementName=PopuButton}"
                            Placement="Bottom"
                            StaysOpen="False">
                            <TreeView
                                Name="ActualTreeView"
                                ItemTemplate="{TemplateBinding ItemTemplate}"
                                ItemsSource="{TemplateBinding ItemsSource}"
                                ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <TreeView.Resources>
                                    <Style TargetType="{x:Type TreeViewItem}">
                                        <Setter Property="IsExpanded" Value="True" />
                                    </Style>
                                </TreeView.Resources>
                            </TreeView>
                        </Popup>
                        <TextBox IsReadOnly="True" Text="{TemplateBinding Text}" />
                        <ToggleButton
                            x:Name="PopuButton"
                            Grid.Column="1"
                            Style="{DynamicResource ComboBoxTreeUpDownButtonStyle}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ComboBoxTreeUpDownButtonStyle" TargetType="ToggleButton">
        <Setter Property="Background" Value="#50000000" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border
                        Background="{TemplateBinding Background}"
                        BorderBrush="Gray"
                        BorderThickness="0.5">
                        <Grid>
                            <Path Fill="White">
                                <Path.Data>
                                    <PathGeometry Figures="M 5 5 L 15 5 L 10 14" />
                                </Path.Data>
                            </Path>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#20000000" />
                        </Trigger>

                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Background" Value="#80000000" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
