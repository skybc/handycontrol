<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:hc="clr-namespace:HandyControl.Controls">

    <Style x:Key="LoadingCircleBaseStyle" BasedOn="{StaticResource LoadingBaseStyle}" TargetType="hc:LoadingCircle">
        <Setter Property="Width" Value="{StaticResource LoadingCircleBaseWidthToken1}"/>
        <Setter Property="Height" Value="{StaticResource LoadingCircleBaseHeightToken1}"/>
        <Setter Property="DotDiameter" Value="{StaticResource LoadingCircleBaseDotDiameterToken1}"/>
        <Setter Property="DotInterval" Value="{StaticResource LoadingCircleBaseDotIntervalToken1}"/>
        <Setter Property="DotOffSet" Value="{StaticResource LoadingCircleBaseDotOffSetToken1}"/>
        <Setter Property="DotDelayTime" Value="90"/>
        <Setter Property="DotSpeed" Value="4"/>
    </Style>

</ResourceDictionary>
