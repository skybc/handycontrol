<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:hc="clr-namespace:HandyControl.Controls">

    <Style x:Key="ToolTipBaseStyle" TargetType="ToolTip">
        <Setter Property="Padding" Value="{StaticResource ToolTipBasePaddingToken1}"/>
        <Setter Property="Background" Value="{DynamicResource ToolTipBaseBackgroundToken1}"/>
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
        <Setter Property="FontSize" Value="{StaticResource ToolTipBaseFontSizeToken1}"/>
        <Setter Property="hc:BorderElement.CornerRadius" Value="{StaticResource ToolTipBaseCornerRadiusToken1}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Effect="{StaticResource EffectShadow2}" Margin="{StaticResource ToolTipBaseMarginToken1}" Background="{DynamicResource RegionBrush}" Padding="{TemplateBinding Padding}" BorderThickness="{StaticResource ToolTipBaseBorderThicknessToken1}" CornerRadius="{Binding Path=(hc:BorderElement.CornerRadius),RelativeSource={RelativeSource TemplatedParent}}" BorderBrush="{DynamicResource BorderBrush}">
                        <ContentPresenter Margin="{StaticResource ToolTipBaseMarginToken2}"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
