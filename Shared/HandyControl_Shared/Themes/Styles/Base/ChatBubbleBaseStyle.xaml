<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:hc="clr-namespace:HandyControl.Controls">

    <ControlTemplate x:Key="ChatBubbleStringBaseTemplate" TargetType="hc:ChatBubble">
        <hc:SimplePanel>
            <Path Name="Tail"  Data="{StaticResource BubbleTailGeometry}" Fill="{TemplateBinding Background}" HorizontalAlignment="Right" Stretch="Uniform" VerticalAlignment="Bottom" Width="{StaticResource ChatBubbleBaseWidthToken1}" Height="{StaticResource ChatBubbleBaseHeightToken1}" RenderTransformOrigin="0.5,0.5"/>
            <Border Name="Body" Background="{TemplateBinding Background}" CornerRadius="{StaticResource ChatBubbleBaseCornerRadiusToken1}" Margin="{StaticResource ChatBubbleBaseMarginToken1}">
                <TextBlock TextWrapping="Wrap" Text="{TemplateBinding Content}" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
            </Border>
        </hc:SimplePanel>
        <ControlTemplate.Triggers>
            <Trigger Property="Role" Value="Receiver">
                <Setter TargetName="Tail" Property="HorizontalAlignment" Value="Left"/>
                <Setter TargetName="Tail" Property="RenderTransform">
                    <Setter.Value>
                        <TransformGroup>
                            <ScaleTransform ScaleY="1" ScaleX="-1"/>
                        </TransformGroup>
                    </Setter.Value>
                </Setter>
                <Setter TargetName="Body" Property="Margin" Value="{StaticResource ChatBubbleBaseMarginToken2}"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <ControlTemplate x:Key="ChatBubbleImageBaseTemplate" TargetType="hc:ChatBubble">
        <hc:SimplePanel>
            <Path Name="Tail"  Data="{StaticResource BubbleTailGeometry}" Fill="{TemplateBinding Background}" HorizontalAlignment="Right" Stretch="Uniform" VerticalAlignment="Bottom" Width="{StaticResource ChatBubbleBaseWidthToken1}" Height="{StaticResource ChatBubbleBaseHeightToken1}" RenderTransformOrigin="0.5,0.5"/>
            <Border Name="Body" Background="{TemplateBinding Background}" CornerRadius="{StaticResource ChatBubbleBaseCornerRadiusToken1}" Margin="{StaticResource ChatBubbleBaseMarginToken1}">
                <hc:SimplePanel>
                    <Image Margin="{TemplateBinding Padding}" VerticalAlignment="Center" Source="{TemplateBinding Content}"/>
                    <Border BorderThickness="{TemplateBinding Padding}" BorderBrush="{TemplateBinding Background}" Background="{x:Null}" CornerRadius="{StaticResource ChatBubbleBaseCornerRadiusToken1}"/>
                </hc:SimplePanel>
            </Border>
        </hc:SimplePanel>
        <ControlTemplate.Triggers>
            <Trigger Property="Role" Value="Receiver">
                <Setter TargetName="Tail" Property="HorizontalAlignment" Value="Left"/>
                <Setter TargetName="Tail" Property="RenderTransform">
                    <Setter.Value>
                        <TransformGroup>
                            <ScaleTransform ScaleY="1" ScaleX="-1"/>
                        </TransformGroup>
                    </Setter.Value>
                </Setter>
                <Setter TargetName="Body" Property="Margin" Value="{StaticResource ChatBubbleBaseMarginToken2}"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <ControlTemplate x:Key="ChatBubbleAudioBaseTemplate" TargetType="hc:ChatBubble">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="{StaticResource ChatBubbleBaseWidthToken2}" Name="Definition1"/>
                <ColumnDefinition Name="Definition2"/>
            </Grid.ColumnDefinitions>
            <Ellipse Name="Dot" VerticalAlignment="Top" Fill="{DynamicResource DangerBrush}" Width="{StaticResource ChatBubbleBaseWidthToken3}" Height="{StaticResource ChatBubbleBaseHeightToken2}" Visibility="{TemplateBinding IsRead,Converter={StaticResource Boolean2VisibilityReConverter}}" Margin="{StaticResource ChatBubbleBaseMarginToken3}"/>
            <Path Name="Tail" Grid.Column="1" Data="{StaticResource BubbleTailGeometry}" Fill="{TemplateBinding Background}" HorizontalAlignment="Right" Stretch="Uniform" VerticalAlignment="Bottom" Width="{StaticResource ChatBubbleBaseWidthToken1}" Height="{StaticResource ChatBubbleBaseHeightToken1}" RenderTransformOrigin="0.5,0.5"/>
            <Border Name="Body" Grid.Column="1" Background="{TemplateBinding Background}" CornerRadius="{StaticResource ChatBubbleBaseCornerRadiusToken1}" Margin="{StaticResource ChatBubbleBaseMarginToken1}">
                <Grid VerticalAlignment="Center" Margin="{TemplateBinding Padding}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ContentPresenter Name="Presenter" VerticalAlignment="Center"/>
                    <Path Name="Audio" Grid.Column="1" Data="{StaticResource AudioGeometry}" Fill="{TemplateBinding Foreground}" Width="{StaticResource ChatBubbleBaseWidthToken4}" Height="{StaticResource ChatBubbleBaseHeightToken3}" Margin="{StaticResource ChatBubbleBaseMarginToken4}" RenderTransformOrigin="0.5,0.5">
                        <Path.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform ScaleY="1" ScaleX="-1"/>
                            </TransformGroup>
                        </Path.RenderTransform>
                    </Path>
                </Grid>
            </Border>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="Role" Value="Receiver">
                <Setter TargetName="Tail" Property="HorizontalAlignment" Value="Left"/>
                <Setter TargetName="Tail" Property="RenderTransform">
                    <Setter.Value>
                        <TransformGroup>
                            <ScaleTransform ScaleY="1" ScaleX="-1"/>
                        </TransformGroup>
                    </Setter.Value>
                </Setter>
                <Setter TargetName="Tail" Property="Grid.Column" Value="0"/>
                <Setter TargetName="Dot" Property="Grid.Column" Value="1"/>
                <Setter TargetName="Dot" Property="Margin" Value="{StaticResource ChatBubbleBaseMarginToken4}"/>
                <Setter TargetName="Body" Property="Margin" Value="{StaticResource ChatBubbleBaseMarginToken2}"/>
                <Setter TargetName="Body" Property="Grid.Column" Value="0"/>
                <Setter TargetName="Definition1" Property="Width" Value="Auto"/>
                <Setter TargetName="Definition2" Property="Width" Value="{StaticResource ChatBubbleBaseWidthToken5}"/>
                <Setter TargetName="Audio" Property="Grid.Column" Value="0"/>
                <Setter TargetName="Audio" Property="Margin" Value="{StaticResource ChatBubbleBaseMarginToken3}"/>
                <Setter TargetName="Audio" Property="RenderTransform">
                    <Setter.Value>
                        <TransformGroup>
                            <ScaleTransform ScaleY="1" ScaleX="1"/>
                        </TransformGroup>
                    </Setter.Value>
                </Setter>
                <Setter TargetName="Presenter" Property="Grid.Column" Value="1"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <ControlTemplate x:Key="ChatBubbleCustomBaseTemplate" TargetType="hc:ChatBubble">
        <hc:SimplePanel>
            <Path Name="Tail"  Data="{StaticResource BubbleTailGeometry}" Fill="{TemplateBinding Background}" HorizontalAlignment="Right" Stretch="Uniform" VerticalAlignment="Bottom" Width="{StaticResource ChatBubbleBaseWidthToken1}" Height="{StaticResource ChatBubbleBaseHeightToken1}" RenderTransformOrigin="0.5,0.5"/>
            <Border Name="Body" Background="{TemplateBinding Background}" CornerRadius="{StaticResource ChatBubbleBaseCornerRadiusToken1}" Margin="{StaticResource ChatBubbleBaseMarginToken1}">
                <ContentPresenter VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
            </Border>
        </hc:SimplePanel>
        <ControlTemplate.Triggers>
            <Trigger Property="Role" Value="Receiver">
                <Setter TargetName="Tail" Property="HorizontalAlignment" Value="Left"/>
                <Setter TargetName="Tail" Property="RenderTransform">
                    <Setter.Value>
                        <TransformGroup>
                            <ScaleTransform ScaleY="1" ScaleX="-1"/>
                        </TransformGroup>
                    </Setter.Value>
                </Setter>
                <Setter TargetName="Body" Property="Margin" Value="{StaticResource ChatBubbleBaseMarginToken2}"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style x:Key="ChatBubbleBaseStyle" TargetType="hc:ChatBubble">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="HorizontalAlignment" Value="Right"/>
        <Setter Property="Background" Value="{DynamicResource DarkPrimaryBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextIconBrush}"/>
        <Setter Property="Padding" Value="{StaticResource ChatBubbleBasePaddingToken1}"/>
        <Setter Property="Margin" Value="{StaticResource ChatBubbleBaseMarginToken5}"/>
        <Setter Property="MinHeight" Value="{StaticResource DefaultControlHeight}"/>
        <Setter Property="Template" Value="{StaticResource ChatBubbleStringBaseTemplate}"/>
        <Setter Property="IsRead" Value="{Binding IsSelected,RelativeSource={RelativeSource Self}}"/>
        <Setter Property="MaxWidth" Value="{StaticResource ChatBubbleBaseMaxWidthToken1}"/>
        <Style.Triggers>
            <Trigger Property="Role" Value="Receiver">
                <Setter Property="Background" Value="{DynamicResource BorderBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
                <Setter Property="HorizontalAlignment" Value="Left"/>
            </Trigger>
            <Trigger Property="Type" Value="Image">
                <Setter Property="Template" Value="{StaticResource ChatBubbleImageBaseTemplate}"/>
                <Setter Property="MaxHeight" Value="{StaticResource ChatBubbleBaseMaxHeightToken1}"/>
            </Trigger>
            <Trigger Property="Type" Value="Audio">
                <Setter Property="Template" Value="{StaticResource ChatBubbleAudioBaseTemplate}"/>
            </Trigger>
            <Trigger Property="Type" Value="Custom">
                <Setter Property="Template" Value="{StaticResource ChatBubbleCustomBaseTemplate}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>
