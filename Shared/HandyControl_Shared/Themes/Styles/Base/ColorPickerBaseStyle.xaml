<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:langs="clr-namespace:HandyControl.Properties.Langs"
                    xmlns:hc="clr-namespace:HandyControl.Controls"
                    xmlns:interactivity="clr-namespace:HandyControl.Interactivity"
                    xmlns:ex="clr-namespace:HandyControl.Tools.Extension">

    <Style x:Key="ColorPickerSliderRepeatButtonBaseStyle" TargetType="RepeatButton">
        <Setter Property="OverridesDefaultStyle" Value="true"/>
        <Setter Property="Background" Value="{DynamicResource ColorPickerBaseBackgroundToken1}"/>
        <Setter Property="Focusable" Value="false"/>
        <Setter Property="IsTabStop" Value="false"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Rectangle Fill="{TemplateBinding Background}" Height="{TemplateBinding Height}" Width="{TemplateBinding Width}"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <ControlTemplate x:Key="ColorPickerSliderThumbTemplate" TargetType="Thumb">
        <Border Width="{StaticResource ColorPickerBaseWidthToken1}" Height="{StaticResource ColorPickerBaseHeightToken1}" Background="{DynamicResource ColorPickerBaseBackgroundToken2}" CornerRadius="{StaticResource ColorPickerBaseCornerRadiusToken1}"/>
    </ControlTemplate>

    <ControlTemplate x:Key="ColorPickerSliderHorizontal" TargetType="Slider">
        <hc:SimplePanel>
            <Border Margin="{StaticResource ColorPickerBaseMarginToken1}" Background="{TemplateBinding Background}" MaxHeight="{StaticResource ColorPickerBaseMaxHeightToken1}" CornerRadius="{StaticResource ColorPickerBaseCornerRadiusToken2}"/>
            <Border Margin="{StaticResource ColorPickerBaseMarginToken1}" Background="{TemplateBinding Foreground}" MaxHeight="{StaticResource ColorPickerBaseMaxHeightToken1}" CornerRadius="{StaticResource ColorPickerBaseCornerRadiusToken2}">
                <Border.OpacityMask>
                    <LinearGradientBrush EndPoint="0,0.5" StartPoint="1,0.5">
                        <GradientStop Color="{StaticResource ColorPickerBaseColorToken1}" Offset="1"/>
                        <GradientStop Color="{StaticResource ColorPickerBaseColorToken2}" Offset="0"/>
                    </LinearGradientBrush>
                </Border.OpacityMask>
            </Border>
            <Track x:Name="PART_Track">
                <Track.DecreaseRepeatButton>
                    <RepeatButton Command="{x:Static Slider.DecreaseLarge}" Style="{StaticResource ColorPickerSliderRepeatButtonBaseStyle}"/>
                </Track.DecreaseRepeatButton>
                <Track.IncreaseRepeatButton>
                    <RepeatButton Command="{x:Static Slider.IncreaseLarge}" Style="{StaticResource ColorPickerSliderRepeatButtonBaseStyle}"/>
                </Track.IncreaseRepeatButton>
                <Track.Thumb>
                    <Thumb x:Name="Thumb" Focusable="False" Height="{StaticResource ColorPickerBaseHeightToken1}" Width="{StaticResource ColorPickerBaseWidthToken1}" OverridesDefaultStyle="True" Template="{StaticResource ColorPickerSliderThumbTemplate}" VerticalAlignment="Center">
                        <Thumb.Effect>
                            <DropShadowEffect ShadowDepth="{StaticResource ColorPickerBaseShadowDepthToken1}" Opacity=".6"/>
                        </Thumb.Effect>
                    </Thumb>
                </Track.Thumb>
            </Track>
        </hc:SimplePanel>
    </ControlTemplate>

    <ControlTemplate x:Key="ColorPickerSliderVertical" TargetType="Slider">
        <hc:SimplePanel>
            <Border Margin="{StaticResource ColorPickerBaseMarginToken2}" CornerRadius="{StaticResource ColorPickerBaseCornerRadiusToken2}" MaxWidth="{StaticResource ColorPickerBaseMaxWidthToken1}" Background="{TemplateBinding Background}"/>
            <Border Margin="{StaticResource ColorPickerBaseMarginToken2}" CornerRadius="{StaticResource ColorPickerBaseCornerRadiusToken2}" MaxWidth="{StaticResource ColorPickerBaseMaxWidthToken1}" Background="{TemplateBinding Foreground}">
                <Border.OpacityMask>
                    <LinearGradientBrush EndPoint="0,0.5" StartPoint="1,0.5">
                        <GradientStop Color="{StaticResource ColorPickerBaseColorToken1}" Offset="1"/>
                        <GradientStop Color="{StaticResource ColorPickerBaseColorToken2}" Offset="0"/>
                    </LinearGradientBrush>
                </Border.OpacityMask>
            </Border>
            <Track x:Name="PART_Track">
                <Track.DecreaseRepeatButton>
                    <RepeatButton Command="{x:Static Slider.DecreaseLarge}" Style="{StaticResource ColorPickerSliderRepeatButtonBaseStyle}"/>
                </Track.DecreaseRepeatButton>
                <Track.IncreaseRepeatButton>
                    <RepeatButton Command="{x:Static Slider.IncreaseLarge}" Style="{StaticResource ColorPickerSliderRepeatButtonBaseStyle}"/>
                </Track.IncreaseRepeatButton>
                <Track.Thumb>
                    <Thumb x:Name="Thumb" Focusable="False" Height="{StaticResource ColorPickerBaseHeightToken1}" OverridesDefaultStyle="True" Template="{StaticResource ColorPickerSliderThumbTemplate}" VerticalAlignment="Top" Width="{StaticResource ColorPickerBaseWidthToken1}">
                        <Thumb.Effect>
                            <DropShadowEffect ShadowDepth="{StaticResource ColorPickerBaseShadowDepthToken1}" Opacity=".6"/>
                        </Thumb.Effect>
                    </Thumb>
                </Track.Thumb>
            </Track>
        </hc:SimplePanel>
    </ControlTemplate>

    <Style x:Key="ColorPickerSlider" BasedOn="{StaticResource BaseStyle}" TargetType="Slider">
        <Setter Property="Stylus.IsPressAndHoldEnabled" Value="false"/>
        <Setter Property="Background" Value="{DynamicResource ColorPickerBaseBackgroundToken1}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ColorPickerBaseBorderBrushToken1}"/>
        <Setter Property="Foreground" Value="{DynamicResource ColorPickerBaseForegroundToken1}"/>
        <Setter Property="Template" Value="{StaticResource ColorPickerSliderHorizontal}"/>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Vertical">
                <Setter Property="Template" Value="{StaticResource ColorPickerSliderVertical}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <LinearGradientBrush x:Key="ColorPickerRainbowBrush">
        <GradientStop Color="{StaticResource ColorPickerBaseColorToken3}"/>
        <GradientStop Color="{StaticResource ColorPickerBaseColorToken4}" Offset="0.167"/>
        <GradientStop Color="{StaticResource ColorPickerBaseColorToken5}" Offset="0.334"/>
        <GradientStop Color="{StaticResource ColorPickerBaseColorToken6}" Offset="0.501"/>
        <GradientStop Color="{StaticResource ColorPickerBaseColorToken7}" Offset="0.668"/>
        <GradientStop Color="{StaticResource ColorPickerBaseColorToken8}" Offset="0.835"/>
        <GradientStop Color="{StaticResource ColorPickerBaseColorToken3}" Offset="1"/>
    </LinearGradientBrush>

    <DrawingBrush x:Key="ColorPickerOpacityBrush" Viewport="0,0,12,11" ViewportUnits="Absolute" Stretch="None" TileMode="Tile">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="{StaticResource ColorPickerBaseBrushToken1}">
                    <GeometryDrawing.Geometry>
                        <GeometryGroup>
                            <RectangleGeometry Rect="0,0,6,5" />
                            <RectangleGeometry Rect="6,6,6,5" />
                        </GeometryGroup>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Brush="{StaticResource ColorPickerBaseBrushToken2}">
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="0,5,12,1" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>

    <Style x:Key="ColorPickerBaseStyle" TargetType="hc:ColorPicker">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Width" Value="{StaticResource ColorPickerBaseWidthToken2}"/>
        <Setter Property="Background" Value="{DynamicResource RegionBrush}"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="hc:ColorPicker">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="{StaticResource ColorPickerBaseHeightToken2}"/>
                            <RowDefinition Height="{StaticResource ColorPickerBaseHeightToken3}"/>
                            <RowDefinition Height="{StaticResource ColorPickerBaseHeightToken4}"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Border BorderThickness="{StaticResource ColorPickerBaseBorderThicknessToken1}" BorderBrush="{DynamicResource BorderBrush}" Grid.RowSpan="4" Background="{TemplateBinding Background}"/>
                        <hc:SimplePanel Margin="{StaticResource ColorPickerBaseMarginToken3}" Grid.Row="0">
                            <Border Background="{TemplateBinding BackColor}"/>
                            <Border>
                                <Border.Background>
                                    <LinearGradientBrush EndPoint="0,0.5" StartPoint="1,0.5">
                                        <GradientStop Color="{StaticResource ColorPickerBaseColorToken2}" Offset="1"/>
                                        <GradientStop Color="{StaticResource ColorPickerBaseColorToken9}" Offset=".5"/>
                                        <GradientStop Color="{StaticResource ColorPickerBaseColorToken10}"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                            <Border>
                                <Border.Background>
                                    <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                                        <GradientStop Color="{StaticResource ColorPickerBaseColorToken11}" Offset="1"/>
                                        <GradientStop Color="{StaticResource ColorPickerBaseColorToken12}" Offset=".5"/>
                                        <GradientStop Color="{StaticResource ColorPickerBaseColorToken13}"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                        </hc:SimplePanel>
                        <Border Name="PART_BorderColor" Grid.Row="0" CornerRadius="{StaticResource ColorPickerBaseCornerRadiusToken3}" ClipToBounds="True">
                            <Canvas Margin="{StaticResource ColorPickerBaseMarginToken4}">
                                <Border Name="PART_BorderPicker" Background="{DynamicResource ColorPickerBaseBackgroundToken1}" Height="{StaticResource ColorPickerBaseHeightToken5}" CornerRadius="{StaticResource ColorPickerBaseCornerRadiusToken4}" Width="{StaticResource ColorPickerBaseWidthToken3}" BorderThickness="{StaticResource ColorPickerBaseBorderThicknessToken1}" BorderBrush="{DynamicResource ColorPickerBaseBorderBrushToken2}">
                                    <Border.Effect>
                                        <DropShadowEffect ShadowDepth="{StaticResource ColorPickerBaseShadowDepthToken1}" Opacity=".4"/>
                                    </Border.Effect>
                                </Border>
                            </Canvas>
                        </Border>
                        <Border Grid.Row="0" Background="{DynamicResource ColorPickerBaseBackgroundToken1}" Name="PART_BorderDrag"/>
                        <Grid Margin="{StaticResource ColorPickerBaseMarginToken5}" Grid.Row="1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="{StaticResource ColorPickerBaseWidthToken4}"/>
                            </Grid.ColumnDefinitions>
                            <ToggleButton Name="PART_ButtonDropper" Width="{StaticResource ColorPickerBaseWidthToken5}" Height="{StaticResource ColorPickerBaseHeightToken6}" Margin="{StaticResource ColorPickerBaseMarginToken6}" Style="{StaticResource ToggleButtonCustom}" hc:StatusSwitchElement.HideUncheckedElement="True">
                                <Path Stretch="Uniform" Data="{StaticResource DropperGeometry}" Fill="{DynamicResource PrimaryTextBrush}"/>
                                <hc:StatusSwitchElement.CheckedElement>
                                    <Path Stretch="Uniform" Data="{StaticResource DropperGeometry}" Fill="{DynamicResource DarkPrimaryBrush}"/>
                                </hc:StatusSwitchElement.CheckedElement>
                            </ToggleButton>
                            <Border Grid.Row="0" Grid.Column="1" Width="{StaticResource ColorPickerBaseWidthToken6}" Height="{StaticResource ColorPickerBaseHeightToken7}" CornerRadius="{StaticResource ColorPickerBaseCornerRadiusToken5}" Background="{StaticResource ColorPickerOpacityBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="{StaticResource ColorPickerBaseBorderThicknessToken1}"/>
                            <Border Grid.Row="0" Grid.Column="1" Width="{StaticResource ColorPickerBaseWidthToken6}" Height="{StaticResource ColorPickerBaseHeightToken7}" CornerRadius="{StaticResource ColorPickerBaseCornerRadiusToken5}" Background="{TemplateBinding SelectedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="{StaticResource ColorPickerBaseBorderThicknessToken1}"/>
                            <Slider Name="PART_SliderColor" LargeChange="0.01" SmallChange="0.01" Grid.ColumnSpan="2" Value="6" Maximum="6" Background="{StaticResource ColorPickerRainbowBrush}" Margin="{StaticResource ColorPickerBaseMarginToken7}" Grid.Row="0" Grid.Column="2" VerticalAlignment="Top" Style="{StaticResource ColorPickerSlider}" IsMoveToPointEnabled="True"/>
                            <Slider Name="PART_SliderOpacity" Grid.ColumnSpan="2" IsSnapToTickEnabled="True" Value="{Binding ChannelA,RelativeSource={RelativeSource TemplatedParent},Mode=TwoWay}" Maximum="255" SmallChange="1" Foreground="{TemplateBinding SelectedBrushWithoutOpacity}" Background="{StaticResource ColorPickerOpacityBrush}" Margin="{StaticResource ColorPickerBaseMarginToken8}" Grid.Row="0" Grid.Column="2" VerticalAlignment="Bottom" Style="{StaticResource ColorPickerSlider}" IsMoveToPointEnabled="True"/>
                            <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Margin="{StaticResource ColorPickerBaseMarginToken9}" VerticalAlignment="Top" Visibility="{Binding ShowList[0],RelativeSource={RelativeSource TemplatedParent},Converter={StaticResource Boolean2VisibilityConverter}}">
                                <TextBox Padding="{StaticResource ColorPickerBasePaddingToken1}" HorizontalContentAlignment="Center" Width="{StaticResource ColorPickerBaseWidthToken7}" Text="{Binding SelectedBrush,RelativeSource={RelativeSource TemplatedParent},Mode=TwoWay,Converter={StaticResource Color2HexStringConverter},UpdateSourceTrigger=LostFocus}" FontSize="{StaticResource ColorPickerBaseFontSizeToken1}" MaxLength="10" Height="{StaticResource ColorPickerBaseHeightToken8}" />
                                <TextBlock Foreground="{DynamicResource ThirdlyTextBrush}" Margin="{StaticResource ColorPickerBaseMarginToken10}" FontSize="{StaticResource ColorPickerBaseFontSizeToken1}" Text="HEX" HorizontalAlignment="Center"/>
                            </StackPanel>
                            <UniformGrid Name="PART_PanelRgb" Visibility="{Binding ShowList[1],RelativeSource={RelativeSource TemplatedParent},Converter={StaticResource Boolean2VisibilityConverter}}" Rows="1" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Margin="{StaticResource ColorPickerBaseMarginToken11}" VerticalAlignment="Top">
                                <StackPanel Margin="{StaticResource ColorPickerBaseMarginToken12}">
                                    <hc:NumericUpDown HorizontalContentAlignment="Center" Padding="{StaticResource ColorPickerBasePaddingToken2}" Tag="R" Value="{Binding ChannelR,RelativeSource={RelativeSource TemplatedParent},Mode=TwoWay}" ShowUpDownButton="False" Maximum="255" Minimum="0" FontSize="{StaticResource ColorPickerBaseFontSizeToken1}" Height="{StaticResource ColorPickerBaseHeightToken8}" />
                                    <TextBlock Foreground="{DynamicResource ThirdlyTextBrush}" Margin="{StaticResource ColorPickerBaseMarginToken10}" FontSize="{StaticResource ColorPickerBaseFontSizeToken1}" Text="R" HorizontalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Margin="{StaticResource ColorPickerBaseMarginToken12}">
                                    <hc:NumericUpDown HorizontalContentAlignment="Center" Padding="{StaticResource ColorPickerBasePaddingToken1}" Tag="G" Value="{Binding ChannelG,RelativeSource={RelativeSource TemplatedParent},Mode=TwoWay}" ShowUpDownButton="False" Maximum="255" Minimum="0" FontSize="{StaticResource ColorPickerBaseFontSizeToken1}" Height="{StaticResource ColorPickerBaseHeightToken8}" />
                                    <TextBlock Foreground="{DynamicResource ThirdlyTextBrush}" Margin="{StaticResource ColorPickerBaseMarginToken10}" FontSize="{StaticResource ColorPickerBaseFontSizeToken1}" Text="G" HorizontalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Margin="{StaticResource ColorPickerBaseMarginToken12}">
                                    <hc:NumericUpDown HorizontalContentAlignment="Center" Padding="{StaticResource ColorPickerBasePaddingToken1}" Tag="B" Value="{Binding ChannelB,RelativeSource={RelativeSource TemplatedParent},Mode=TwoWay}" ShowUpDownButton="False" Maximum="255" Minimum="0" FontSize="{StaticResource ColorPickerBaseFontSizeToken1}" Height="{StaticResource ColorPickerBaseHeightToken8}" />
                                    <TextBlock Foreground="{DynamicResource ThirdlyTextBrush}" Margin="{StaticResource ColorPickerBaseMarginToken10}" FontSize="{StaticResource ColorPickerBaseFontSizeToken1}" Text="B" HorizontalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Margin="{StaticResource ColorPickerBaseMarginToken12}">
                                    <hc:NumericUpDown HorizontalContentAlignment="Center" Padding="{StaticResource ColorPickerBasePaddingToken1}" Value="{Binding ChannelA,RelativeSource={RelativeSource TemplatedParent},Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" ShowUpDownButton="False" Maximum="255" Minimum="0" FontSize="{StaticResource ColorPickerBaseFontSizeToken1}" Height="{StaticResource ColorPickerBaseHeightToken8}" />
                                    <TextBlock Foreground="{DynamicResource ThirdlyTextBrush}" Margin="{StaticResource ColorPickerBaseMarginToken10}" FontSize="{StaticResource ColorPickerBaseFontSizeToken1}" Text="A" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </UniformGrid>
                            <Button Command="interactivity:ControlCommands.Switch" Padding="{StaticResource ColorPickerBasePaddingToken3}" FontSize="{StaticResource ColorPickerBaseFontSizeToken2}" BorderThickness="{StaticResource ColorPickerBaseBorderThicknessToken2}" HorizontalAlignment="Right" Height="{StaticResource ColorPickerBaseHeightToken8}" Width="{StaticResource ColorPickerBaseWidthToken8}" Grid.Column="3" Grid.Row="1">
                                <Button.Content>
                                    <Path Fill="{DynamicResource ColorPickerBaseFillToken1}" Style="{StaticResource UpDownPathStyle}"/>
                                </Button.Content>
                            </Button>
                        </Grid>
                        <Border Grid.Row="2" BorderThickness="{StaticResource ColorPickerBaseBorderThicknessToken3}" BorderBrush="{DynamicResource BorderBrush}">
                            <WrapPanel Name="PART_PanelColor" Margin="{StaticResource ColorPickerBaseMarginToken13}" HorizontalAlignment="Center"/>
                        </Border>
                        <Border Name="PART_BorderButtons" Grid.Row="3" BorderThickness="{StaticResource ColorPickerBaseBorderThicknessToken3}" BorderBrush="{DynamicResource BorderBrush}" Height="{StaticResource ColorPickerBaseHeightToken9}">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding ShowConfirmButton,RelativeSource={RelativeSource TemplatedParent}}" Value="False"/>
                                                <Condition Binding="{Binding ShowCancelButton,RelativeSource={RelativeSource TemplatedParent}}" Value="False"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Button Command="interactivity:ControlCommands.Cancel" Content="{ex:Lang Key={x:Static langs:LangKeys.Cancel}}" Width="{StaticResource ColorPickerBaseWidthToken9}" Margin="{StaticResource ColorPickerBaseMarginToken14}" Visibility="{Binding ShowCancelButton,RelativeSource={RelativeSource TemplatedParent},Converter={StaticResource Boolean2VisibilityConverter}}"/>
                                <Button Command="interactivity:ControlCommands.Confirm" Content="{ex:Lang Key={x:Static langs:LangKeys.Confirm}}" Width="{StaticResource ColorPickerBaseWidthToken9}" Style="{StaticResource ButtonPrimary}" Visibility="{Binding ShowConfirmButton,RelativeSource={RelativeSource TemplatedParent},Converter={StaticResource Boolean2VisibilityConverter}}"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
