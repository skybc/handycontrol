<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:hc="clr-namespace:HandyControl.Controls"
    xmlns:interactivity="clr-namespace:HandyControl.Interactivity">

    <Style x:Key="TreeEditorWindowBaseStyle" TargetType="hc:TreeEditorWindow">
        <Setter Property="Background" Value="{DynamicResource RegionBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
        <Setter Property="ResizeMode" Value="CanResize" />
        <Setter Property="Width" Value="800" />
        <Setter Property="Height" Value="600" />
        <Setter Property="MinWidth" Value="600" />
        <Setter Property="MinHeight" Value="400" />
        <Setter Property="WindowTitle" Value="目录树编辑器" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="hc:TreeEditorWindow">
                    <Border
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource DefaultCornerRadius}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!--  标题栏  -->
                            <Border
                                x:Name="PART_TitleBar"
                                Grid.Row="0"
                                Background="{DynamicResource SecondaryRegionBrush}"
                                CornerRadius="{StaticResource DefaultCornerRadius}">
                                <Grid Height="40">
                                    <TextBlock
                                        Margin="16,0"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        FontSize="14"
                                        FontWeight="Bold"
                                        Foreground="{DynamicResource PrimaryTextBrush}"
                                        Text="{TemplateBinding WindowTitle}" />

                                    <Button
                                        Width="40"
                                        Height="40"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        Command="interactivity:ControlCommands.Cancel"
                                        Content="✕"
                                        Foreground="{DynamicResource PrimaryTextBrush}"
                                        Style="{StaticResource ButtonIcon}" />
                                </Grid>
                            </Border>

                            <!--  主内容区  -->
                            <Grid Grid.Row="1" Margin="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="250" />
                                </Grid.ColumnDefinitions>

                                <!--  左侧目录树区  -->
                                <Border
                                    Grid.Column="0"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{StaticResource DefaultCornerRadius}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>

                                        <!--  工具栏  -->
                                        <Border
                                            Grid.Row="0"
                                            Padding="8"
                                            Background="{DynamicResource SecondaryRegionBrush}"
                                            BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="0,0,0,1">
                                            <StackPanel HorizontalAlignment="Left" Orientation="Horizontal">
                                                <Button
                                                    Width="32"
                                                    Height="32"
                                                    Margin="0,0,4,0"
                                                    Command="interactivity:ControlCommands.Add"
                                                    Style="{StaticResource ButtonIcon}"
                                                    ToolTip="新增子节点">
                                                    <Path
                                                        Width="16"
                                                        Height="16"
                                                        Data="M19,13H13V19H11V13H5V11H11V5H13V11H19V13Z"
                                                        Fill="{DynamicResource PrimaryTextBrush}"
                                                        Stretch="Uniform" />
                                                </Button>
                                                <Button
                                                    Width="32"
                                                    Height="32"
                                                    Command="interactivity:ControlCommands.Delete"
                                                    Style="{StaticResource ButtonIcon}"
                                                    ToolTip="删除选中节点">
                                                    <Path
                                                        Width="16"
                                                        Height="16"
                                                        Data="M19,4H15.5L14.5,3H9.5L8.5,4H5V6H19M6,19A2,2 0 0,0 8,21H16A2,2 0 0,0 18,19V7H6V19Z"
                                                        Fill="{DynamicResource DangerBrush}"
                                                        Stretch="Uniform" />
                                                </Button>
                                            </StackPanel>
                                        </Border>

                                        <!--  树形视图  -->
                                        <TreeView
                                            x:Name="PART_TreeView"
                                            Grid.Row="1"
                                            Padding="8"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            ItemsSource="{TemplateBinding TreeNodes}">
                                            <TreeView.ItemContainerStyle>
                                                <Style TargetType="TreeViewItem">
                                                    <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                                                    <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                                                    <Setter Property="Padding" Value="4,2" />
                                                    <Setter Property="Margin" Value="0,1" />
                                                </Style>
                                            </TreeView.ItemContainerStyle>
                                            <TreeView.ItemTemplate>
                                                <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                                    <Grid Margin="2">
                                                        <TextBox
                                                            Padding="4,2"
                                                            Background="Transparent"
                                                            BorderBrush="{DynamicResource BorderBrush}"
                                                            BorderThickness="1"
                                                            FontFamily="Consolas"
                                                            FontSize="13"
                                                            Text="{Binding Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                    </Grid>
                                                </HierarchicalDataTemplate>
                                            </TreeView.ItemTemplate>
                                        </TreeView>
                                    </Grid>
                                </Border>

                                <!--  分隔符  -->
                                <GridSplitter
                                    Grid.Column="1"
                                    Width="8"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Stretch"
                                    Background="Transparent"
                                    ShowsPreview="True" />

                                <!--  右侧变量列表  -->
                                <Border
                                    Grid.Column="2"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{StaticResource DefaultCornerRadius}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>

                                        <Border
                                            Grid.Row="0"
                                            Padding="12,8"
                                            Background="{DynamicResource SecondaryRegionBrush}"
                                            BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="0,0,0,1">
                                            <TextBlock
                                                FontSize="13"
                                                FontWeight="Bold"
                                                Foreground="{DynamicResource PrimaryTextBrush}"
                                                Text="可用变量" />
                                        </Border>

                                        <ListBox
                                            x:Name="PART_VariableList"
                                            Grid.Row="1"
                                            Padding="8"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            ItemsSource="{TemplateBinding Variables}"
                                            ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Border
                                                        Margin="0,2"
                                                        Padding="8,6"
                                                        Background="{DynamicResource SecondaryRegionBrush}"
                                                        BorderBrush="{DynamicResource BorderBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="4"
                                                        Cursor="Hand">
                                                        <TextBlock
                                                            FontFamily="Consolas"
                                                            FontSize="12"
                                                            Text="{Binding}"
                                                            TextWrapping="Wrap"
                                                            ToolTip="双击插入到选中节点" />
                                                    </Border>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </Grid>
                                </Border>
                            </Grid>

                            <!--  底部按钮区  -->
                            <Border
                                Grid.Row="2"
                                Padding="16,12"
                                Background="{DynamicResource SecondaryRegionBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="0,1,0,0">
                                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                                    <Button
                                        Width="80"
                                        Margin="0,0,8,0"
                                        Command="interactivity:ControlCommands.Confirm"
                                        Content="确定"
                                        Style="{StaticResource ButtonPrimary}" />
                                    <Button
                                        Width="80"
                                        Command="interactivity:ControlCommands.Cancel"
                                        Content="取消"
                                        Style="{StaticResource ButtonDefault}" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style BasedOn="{StaticResource TreeEditorWindowBaseStyle}" TargetType="hc:TreeEditorWindow" />

</ResourceDictionary>
