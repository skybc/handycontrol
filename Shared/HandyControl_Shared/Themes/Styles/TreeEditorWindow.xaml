<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:hc="clr-namespace:HandyControl.Controls"
    xmlns:interactivity="clr-namespace:HandyControl.Interactivity">

    <Style x:Key="TreeEditorWindowBaseStyle" TargetType="hc:TreeEditorWindow">
        <Setter Property="Background" Value="{DynamicResource RegionBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
        <Setter Property="ResizeMode" Value="CanResize" />
        <Setter Property="Width" Value="{StaticResource TreeEditorWindowStyleWidthToken1}" />
        <Setter Property="Height" Value="{StaticResource TreeEditorWindowStyleHeightToken1}" />
        <Setter Property="MinWidth" Value="{StaticResource TreeEditorWindowStyleMinWidthToken1}" />
        <Setter Property="MinHeight" Value="{StaticResource TreeEditorWindowStyleMinHeightToken1}" />
        <Setter Property="WindowTitle" Value="目录树编辑器" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="hc:TreeEditorWindow">
                    <Border
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{StaticResource TreeEditorWindowStyleBorderThicknessToken1}"
                        CornerRadius="{StaticResource DefaultCornerRadius}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!--  标题栏  -->
                            <Border
                                x:Name="PART_TitleBar"
                                Grid.Row="0"
                                Background="{DynamicResource SecondaryRegionBrush}"
                                CornerRadius="{StaticResource DefaultCornerRadius}">
                                <Grid Height="{StaticResource TreeEditorWindowStyleHeightToken2}">
                                    <TextBlock
                                        Margin="{StaticResource TreeEditorWindowStyleMarginToken1}"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        FontSize="{StaticResource TreeEditorWindowStyleFontSizeToken1}"
                                        FontWeight="Bold"
                                        Foreground="{DynamicResource PrimaryTextBrush}"
                                        Text="{TemplateBinding WindowTitle}" />

                                    <Button
                                        Width="{StaticResource TreeEditorWindowStyleWidthToken2}"
                                        Height="{StaticResource TreeEditorWindowStyleHeightToken2}"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        Command="interactivity:ControlCommands.Cancel"
                                        Content="✕"
                                        Foreground="{DynamicResource PrimaryTextBrush}"
                                        Style="{StaticResource ButtonIcon}" />
                                </Grid>
                            </Border>

                            <!--  主内容区  -->
                            <Grid Grid.Row="1" Margin="{StaticResource TreeEditorWindowStyleMarginToken2}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="{StaticResource TreeEditorWindowStyleWidthToken3}" />
                                </Grid.ColumnDefinitions>

                                <!--  左侧目录树区  -->
                                <Border
                                    Grid.Column="0"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="{StaticResource TreeEditorWindowStyleBorderThicknessToken1}"
                                    CornerRadius="{StaticResource DefaultCornerRadius}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>

                                        <!--  工具栏  -->
                                        <Border
                                            Grid.Row="0"
                                            Padding="{StaticResource TreeEditorWindowStylePaddingToken1}"
                                            Background="{DynamicResource SecondaryRegionBrush}"
                                            BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="{StaticResource TreeEditorWindowStyleBorderThicknessToken2}">
                                            <StackPanel HorizontalAlignment="Left" Orientation="Horizontal">
                                                <Button
                                                    Width="{StaticResource TreeEditorWindowStyleWidthToken4}"
                                                    Height="{StaticResource TreeEditorWindowStyleHeightToken3}"
                                                    Margin="{StaticResource TreeEditorWindowStyleMarginToken3}"
                                                    Command="interactivity:ControlCommands.Add"
                                                    Style="{StaticResource ButtonIcon}"
                                                    ToolTip="新增子节点">
                                                    <Path
                                                        Width="{StaticResource TreeEditorWindowStyleWidthToken5}"
                                                        Height="{StaticResource TreeEditorWindowStyleHeightToken4}"
                                                        Data="M19,13H13V19H11V13H5V11H11V5H13V11H19V13Z"
                                                        Fill="{DynamicResource PrimaryTextBrush}"
                                                        Stretch="Uniform" />
                                                </Button>
                                                <Button
                                                    Width="{StaticResource TreeEditorWindowStyleWidthToken4}"
                                                    Height="{StaticResource TreeEditorWindowStyleHeightToken3}"
                                                    Command="interactivity:ControlCommands.Delete"
                                                    Style="{StaticResource ButtonIcon}"
                                                    ToolTip="删除选中节点">
                                                    <Path
                                                        Width="{StaticResource TreeEditorWindowStyleWidthToken5}"
                                                        Height="{StaticResource TreeEditorWindowStyleHeightToken4}"
                                                        Data="M19,4H15.5L14.5,3H9.5L8.5,4H5V6H19M6,19A2,2 0 0,0 8,21H16A2,2 0 0,0 18,19V7H6V19Z"
                                                        Fill="{DynamicResource DangerBrush}"
                                                        Stretch="Uniform" />
                                                </Button>
                                                <Button
                                                    Margin="{StaticResource TreeEditorWindowStyleMarginToken4}"
                                                    Padding="{StaticResource TreeEditorWindowStylePaddingToken2}"
                                                    Command="interactivity:ControlCommands.Save"
                                                    Content="修改"
                                                    Style="{StaticResource ButtonDefault}"
                                                    ToolTip="修改选中节点名称" />
                                            </StackPanel>
                                        </Border>

                                        <!--  树形视图  -->
                                        <TreeView
                                            x:Name="PART_TreeView"
                                            Grid.Row="1"
                                            Padding="{StaticResource TreeEditorWindowStylePaddingToken1}"
                                            Background="{DynamicResource TreeEditorWindowStyleBackgroundToken1}"
                                            BorderThickness="{StaticResource TreeEditorWindowStyleBorderThicknessToken3}"
                                            FontSize="{StaticResource TreeViewFontSize}"
                                            ItemsSource="{TemplateBinding TreeNodes}">
                                            <TreeView.ItemContainerStyle>
                                                <Style BasedOn="{StaticResource TreeViewItemBaseStyle}" TargetType="TreeViewItem">
                                                    <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                                                    <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                                                </Style>
                                            </TreeView.ItemContainerStyle>
                                            <TreeView.ContextMenu>
                                                <ContextMenu>
                                                    <MenuItem
                                                        Command="interactivity:ControlCommands.Add"
                                                        CommandTarget="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                        Header="新增子节点" />
                                                    <MenuItem
                                                        Command="interactivity:ControlCommands.Save"
                                                        CommandTarget="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                        Header="修改节点名称" />
                                                    <MenuItem
                                                        Command="interactivity:ControlCommands.Delete"
                                                        CommandTarget="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                        Header="删除选中节点" />
                                                </ContextMenu>
                                            </TreeView.ContextMenu>
                                            <TreeView.ItemTemplate>
                                                <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                                    <Grid MinHeight="{StaticResource ListRowHeight}">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock
                                                            VerticalAlignment="Center"
                                                            FontSize="{StaticResource TreeViewFontSize}"
                                                            Text="{Binding Text}"
                                                            TextTrimming="CharacterEllipsis">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsError}" Value="True">
                                                                            <Setter Property="Foreground" Value="{DynamicResource DarkDangerBrush}" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                        <TextBlock
                                                            Grid.Column="1"
                                                            Margin="{StaticResource TreeEditorWindowStyleMarginToken5}"
                                                            VerticalAlignment="Center"
                                                            FontSize="{StaticResource TreeViewAuxiliaryFontSize}"
                                                            Foreground="{DynamicResource SecondaryTextBrush}"
                                                            Text="{Binding AdditionalInfo}"
                                                            TextTrimming="CharacterEllipsis" />
                                                        <Path
                                                            Grid.Column="2"
                                                            Width="{StaticResource TreeViewWarningIconSize}"
                                                            Height="{StaticResource TreeViewWarningIconSize}"
                                                            Margin="{StaticResource TreeEditorWindowStyleMarginToken6}"
                                                            VerticalAlignment="Center"
                                                            Data="{StaticResource WarningGeometry}"
                                                            Fill="{DynamicResource DarkDangerBrush}"
                                                            Stretch="Uniform"
                                                            Visibility="{Binding IsError, Converter={StaticResource Boolean2VisibilityConverter}}" />
                                                    </Grid>
                                                </HierarchicalDataTemplate>
                                            </TreeView.ItemTemplate>
                                        </TreeView>
                                    </Grid>
                                </Border>

                                <!--  分隔符  -->
                                <GridSplitter
                                    Grid.Column="1"
                                    Width="{StaticResource TreeEditorWindowStyleWidthToken6}"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Stretch"
                                    Background="{DynamicResource TreeEditorWindowStyleBackgroundToken1}"
                                    ShowsPreview="True" />

                                <!--  右侧变量列表  -->
                                <Border
                                    Grid.Column="2"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="{StaticResource TreeEditorWindowStyleBorderThicknessToken1}"
                                    CornerRadius="{StaticResource DefaultCornerRadius}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>

                                        <Border
                                            Grid.Row="0"
                                            Padding="{StaticResource TreeEditorWindowStylePaddingToken3}"
                                            Background="{DynamicResource SecondaryRegionBrush}"
                                            BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="{StaticResource TreeEditorWindowStyleBorderThicknessToken2}">
                                            <TextBlock
                                                FontSize="{StaticResource TreeEditorWindowStyleFontSizeToken2}"
                                                FontWeight="Bold"
                                                Foreground="{DynamicResource PrimaryTextBrush}"
                                                Text="节点属性" />
                                        </Border>

                                        <StackPanel Grid.Row="1" Margin="{StaticResource TreeEditorWindowStyleMarginToken7}">
                                            <TextBlock
                                                Margin="{StaticResource TreeEditorWindowStyleMarginToken8}"
                                                FontSize="{StaticResource TreeViewAuxiliaryFontSize}"
                                                Foreground="{DynamicResource SecondaryTextBrush}"
                                                Text="节点名称" />
                                            <TextBox
                                                x:Name="PART_NodeTextBox"
                                                MinHeight="{StaticResource TreeEditorWindowStyleMinHeightToken2}"
                                                Padding="{StaticResource TreeEditorWindowStylePaddingToken4}"
                                                FontSize="{StaticResource TreeViewFontSize}"
                                                ToolTip="选择一个节点后，在此处编辑名称，再点“修改”应用。" />
                                        </StackPanel>

                                        <Border
                                            Grid.Row="2"
                                            Padding="{StaticResource TreeEditorWindowStylePaddingToken3}"
                                            Background="{DynamicResource SecondaryRegionBrush}"
                                            BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="{StaticResource TreeEditorWindowStyleBorderThicknessToken4}">
                                            <TextBlock
                                                FontSize="{StaticResource TreeEditorWindowStyleFontSizeToken2}"
                                                FontWeight="Bold"
                                                Foreground="{DynamicResource PrimaryTextBrush}"
                                                Text="可用变量" />
                                        </Border>

                                        <ListBox
                                            x:Name="PART_VariableList"
                                            Grid.Row="3"
                                            Padding="{StaticResource TreeEditorWindowStylePaddingToken1}"
                                            Background="{DynamicResource TreeEditorWindowStyleBackgroundToken1}"
                                            BorderThickness="{StaticResource TreeEditorWindowStyleBorderThicknessToken3}"
                                            ItemsSource="{TemplateBinding Variables}"
                                            ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Border
                                                        Margin="{StaticResource TreeEditorWindowStyleMarginToken9}"
                                                        Padding="{StaticResource TreeEditorWindowStylePaddingToken5}"
                                                        Background="{DynamicResource SecondaryRegionBrush}"
                                                        BorderBrush="{DynamicResource BorderBrush}"
                                                        BorderThickness="{StaticResource TreeEditorWindowStyleBorderThicknessToken1}"
                                                        CornerRadius="{StaticResource TreeEditorWindowStyleCornerRadiusToken1}"
                                                        Cursor="Hand">
                                                        <TextBlock
                                                            FontFamily="Consolas"
                                                            FontSize="{StaticResource TreeEditorWindowStyleFontSizeToken3}"
                                                            Text="{Binding}"
                                                            TextWrapping="Wrap"
                                                            ToolTip="双击插入到选中节点" />
                                                    </Border>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </Grid>
                                </Border>
                            </Grid>

                            <!--  底部按钮区  -->
                            <Border
                                Grid.Row="2"
                                Padding="{StaticResource TreeEditorWindowStylePaddingToken6}"
                                Background="{DynamicResource SecondaryRegionBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="{StaticResource TreeEditorWindowStyleBorderThicknessToken5}">
                                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                                    <Button
                                        Width="{StaticResource TreeEditorWindowStyleWidthToken7}"
                                        Margin="{StaticResource TreeEditorWindowStyleMarginToken10}"
                                        Command="interactivity:ControlCommands.Confirm"
                                        Content="确定"
                                        Style="{StaticResource ButtonPrimary}" />
                                    <Button
                                        Width="{StaticResource TreeEditorWindowStyleWidthToken7}"
                                        Command="interactivity:ControlCommands.Cancel"
                                        Content="取消"
                                        Style="{StaticResource ButtonDefault}" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style BasedOn="{StaticResource TreeEditorWindowBaseStyle}" TargetType="hc:TreeEditorWindow" />

</ResourceDictionary>
