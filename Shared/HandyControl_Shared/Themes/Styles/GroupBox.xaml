<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:hc="clr-namespace:HandyControl.Controls">

    <Style BasedOn="{StaticResource GroupBoxBaseStyle}" TargetType="GroupBox" />

    <Style
        x:Key="GroupBox.Small"
        BasedOn="{StaticResource GroupBoxBaseStyle}"
        TargetType="GroupBox">
        <Setter Property="hc:TitleElement.MinHeight" Value="{DynamicResource SmallControlHeight}" />
        <Setter Property="hc:TitleElement.MinWidth" Value="{DynamicResource SmallControlHeight}" />
    </Style>

    <Style
        x:Key="GroupBoxOriginal"
        BasedOn="{StaticResource GroupBoxOriginalBaseStyle}"
        TargetType="GroupBox" />

    <Style
        x:Key="GroupBoxTab"
        BasedOn="{StaticResource GroupBoxTabBaseStyle}"
        TargetType="GroupBox" />

    <Style
        x:Key="GroupBoxTab.Small"
        BasedOn="{StaticResource GroupBoxTab}"
        TargetType="GroupBox">
        <Setter Property="hc:TitleElement.MinHeight" Value="{DynamicResource SmallControlHeight}" />
        <Setter Property="hc:TitleElement.MinWidth" Value="{DynamicResource SmallControlHeight}" />
    </Style>

    <Style x:Key="GroupBoxCard" BasedOn="{StaticResource GroupBoxCardBaseStyle}" TargetType="GroupBox" />

    <Style x:Key="GroupBoxCard.Hover" BasedOn="{StaticResource GroupBoxCardBaseStyle}" TargetType="GroupBox">
        <Setter Property="Template" Value="{StaticResource GroupBoxCardHoverTemplate}" />
    </Style>

    <Style x:Key="GroupBoxCard.NoShadow" BasedOn="{StaticResource GroupBoxCardBaseStyle}" TargetType="GroupBox">
        <Setter Property="Template" Value="{StaticResource GroupBoxCardNoShadowTemplate}" />
    </Style>

</ResourceDictionary>
