<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:hc="clr-namespace:HandyControl.Controls"
                    xmlns:interactivity="clr-namespace:HandyControl.Interactivity">

    <Style TargetType="hc:ImageViewer">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Background" Value="{DynamicResource ImageViewerStyleBackgroundToken1}"/>
        <Setter Property="BorderThickness" Value="{StaticResource ImageViewerStyleBorderThicknessToken1}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="hc:ImageViewer">
                    <Border BorderThickness="{TemplateBinding BorderThickness}" BorderBrush="{TemplateBinding BorderBrush}" Background="{TemplateBinding Background}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <hc:SimplePanel x:Name="PART_PanelMain" ClipToBounds="True" Grid.RowSpan="2">
                                <Border HorizontalAlignment="Left" VerticalAlignment="Top" Height="{TemplateBinding ImageHeight}" Width="{TemplateBinding ImageWidth}" Margin="{TemplateBinding ImageMargin}">
                                    <Image Name="PART_ImageMain" RenderOptions.BitmapScalingMode="NearestNeighbor" RenderTransformOrigin="0.5,0.5" Source="{TemplateBinding ImageSource}"/>
                                </Border>
                            </hc:SimplePanel>
                            <Border Grid.Row="0" Grid.RowSpan="2" Width="{StaticResource ImageViewerStyleWidthToken1}" Height="{StaticResource ImageViewerStyleHeightToken1}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Background="{DynamicResource DarkOpacityBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="{StaticResource ImageViewerStyleBorderThicknessToken1}">
                                <Border.Visibility>
                                    <MultiBinding Converter="{StaticResource BooleanArr2VisibilityConverter}">
                                        <Binding RelativeSource="{RelativeSource TemplatedParent}" Path="ShowSmallImgInternal"/>
                                        <Binding RelativeSource="{RelativeSource TemplatedParent}" Path="ShowImgMap"/>
                                    </MultiBinding>
                                </Border.Visibility>
                                <Canvas ClipToBounds="True" Name="PART_CanvasSmallImg" MaxWidth="{StaticResource ImageViewerStyleMaxWidthToken1}" MaxHeight="{StaticResource ImageViewerStyleMaxHeightToken1}">
                                    <Border UseLayoutRounding="True" Name="PART_BorderMove" Background="{DynamicResource ImageViewerStyleBackgroundToken1}" Width="{StaticResource ImageViewerStyleWidthToken2}" Height="{StaticResource ImageViewerStyleHeightToken2}" BorderThickness="{StaticResource ImageViewerStyleBorderThicknessToken1}" BorderBrush="{DynamicResource ImageViewerStyleBorderBrushToken1}">
                                        <Border BorderThickness="{StaticResource ImageViewerStyleBorderThicknessToken1}" BorderBrush="{DynamicResource ImageViewerStyleBorderBrushToken2}"/>
                                    </Border>
                                </Canvas>
                            </Border>
                            <Border UseLayoutRounding="True" Name="PART_BorderBottom" Visibility="{TemplateBinding ShowToolBar, Converter={StaticResource Boolean2VisibilityConverter}}"  Opacity="0" CornerRadius="{StaticResource ImageViewerStyleCornerRadiusToken1}" Grid.Row="1" HorizontalAlignment="Center" Background="{DynamicResource DarkOpacityBrush}">
                                <StackPanel Margin="{StaticResource ImageViewerStyleMarginToken1}" VerticalAlignment="Center" Orientation="Horizontal">
                                    <Button Command="interactivity:ControlCommands.Save" Margin="{StaticResource ImageViewerStyleMarginToken2}" Foreground="{DynamicResource TextIconBrush}" Style="{StaticResource ButtonIcon}" hc:IconElement.Geometry="{StaticResource SaveGeometry}" Padding="{StaticResource ImageViewerStylePaddingToken1}"/>
                                    <Button Command="interactivity:ControlCommands.Open" Margin="{StaticResource ImageViewerStyleMarginToken2}" Foreground="{DynamicResource TextIconBrush}" Style="{StaticResource ButtonIcon}" hc:IconElement.Geometry="{StaticResource WindowsGeometry}" Padding="{StaticResource ImageViewerStylePaddingToken1}"/>

                                    <Border Margin="{StaticResource ImageViewerStyleMarginToken3}" Background="{DynamicResource ImageViewerStyleBackgroundToken2}" Style="{StaticResource BorderVerticallySplitter}"/>

                                    <Button Command="interactivity:ControlCommands.Reduce" Margin="{StaticResource ImageViewerStyleMarginToken2}" Foreground="{DynamicResource TextIconBrush}" Style="{StaticResource ButtonIcon}" hc:IconElement.Geometry="{StaticResource ReduceGeometry}" Padding="{StaticResource ImageViewerStylePaddingToken1}"/>
                                    <TextBlock Margin="{StaticResource ImageViewerStyleMarginToken2}" Text="{TemplateBinding ScaleStr}" Style="{StaticResource TextBlockSubTitle}" Foreground="{DynamicResource TextIconBrush}"/>
                                    <Button Command="interactivity:ControlCommands.Enlarge" Margin="{StaticResource ImageViewerStyleMarginToken2}" Foreground="{DynamicResource TextIconBrush}" Style="{StaticResource ButtonIcon}" hc:IconElement.Geometry="{StaticResource EnlargeGeometry}" Padding="{StaticResource ImageViewerStylePaddingToken1}"/>
                                    <Button Command="interactivity:ControlCommands.Restore" Background="{DynamicResource ImageViewerStyleBackgroundToken1}" Margin="{StaticResource ImageViewerStyleMarginToken2}" Style="{StaticResource ButtonCustom}" Foreground="{DynamicResource TextIconBrush}">
                                        <Border BorderThickness="{StaticResource ImageViewerStyleBorderThicknessToken1}" BorderBrush="{DynamicResource ImageViewerStyleBorderBrushToken2}" Padding="{StaticResource ImageViewerStylePaddingToken2}">
                                            <TextBlock Text="1:1"/>
                                        </Border>
                                    </Button>
                                    <Border Margin="{StaticResource ImageViewerStyleMarginToken3}" Background="{DynamicResource ImageViewerStyleBackgroundToken2}" Style="{StaticResource BorderVerticallySplitter}"/>
                                    <Button Command="interactivity:ControlCommands.RotateLeft" CommandParameter="" Margin="{StaticResource ImageViewerStyleMarginToken2}"  Foreground="{DynamicResource TextIconBrush}" Style="{StaticResource ButtonIcon}" hc:IconElement.Geometry="{StaticResource RotateLeftGeometry}" Padding="{StaticResource ImageViewerStylePaddingToken1}"/>
                                    <Button Command="interactivity:ControlCommands.RotateRight" Margin="{StaticResource ImageViewerStyleMarginToken4}"  Foreground="{DynamicResource TextIconBrush}" Style="{StaticResource ButtonIcon}" hc:IconElement.Geometry="{StaticResource RotateRightGeometry}" Padding="{StaticResource ImageViewerStylePaddingToken1}"/>
                                    <ToggleButton Visibility="{TemplateBinding ShowFullScreenButton, Converter={StaticResource Boolean2VisibilityConverter}}" Foreground="{DynamicResource TextIconBrush}" IsChecked="{Binding IsFullScreen,RelativeSource={RelativeSource TemplatedParent},Mode=TwoWay}" Margin="{StaticResource ImageViewerStyleMarginToken5}" Style="{StaticResource ToggleButtonIconTransparent}" hc:IconSwitchElement.Geometry="{StaticResource FullScreenGeometry}" hc:IconSwitchElement.GeometrySelected="{StaticResource FullScreenReturnGeometry}" Padding="{StaticResource ImageViewerStylePaddingToken1}"/>

                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
