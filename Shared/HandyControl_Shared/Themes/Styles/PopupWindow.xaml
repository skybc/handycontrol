<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:hc="clr-namespace:HandyControl.Controls"
                    xmlns:interactivity="clr-namespace:HandyControl.Interactivity"
                    xmlns:langs="clr-namespace:HandyControl.Properties.Langs"
                    xmlns:ex="clr-namespace:HandyControl.Tools.Extension">

    <Style TargetType="hc:PopupWindow">
        <Setter Property="WindowStyle" Value="None"/>
        <Setter Property="MinHeight" Value="{StaticResource PopupWindowStyleMinHeightToken1}"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
        <Setter Property="BorderThickness" Value="{StaticResource PopupWindowStyleBorderThicknessToken1}"/>
        <Setter Property="ShowInTaskbar" Value="False"/>
        <Setter Property="MinWidth" Value="{StaticResource PopupWindowStyleMinWidthToken1}"/>
        <Setter Property="ResizeMode" Value="NoResize"/>
        <Setter Property="Background" Value="{DynamicResource RegionBrush}"/>
        <Setter Property="SizeToContent" Value="WidthAndHeight"/>
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect Opacity=".6" ShadowDepth="{StaticResource PopupWindowStyleShadowDepthToken1}" BlurRadius="{StaticResource PopupWindowStyleBlurRadiusToken1}"/>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="hc:PopupWindow">
                    <Border Background="{TemplateBinding Background}" BorderThickness="{TemplateBinding BorderThickness}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid Name="TitleGrid" Height="{StaticResource PopupWindowStyleHeightToken1}" Background="{DynamicResource TitleBrush}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Name="PART_TitleBlock" Background="{DynamicResource PopupWindowStyleBackgroundToken1}" Padding="{StaticResource DefaultControlPadding}" Foreground="{DynamicResource PopupWindowStyleForegroundToken1}" Text="{TemplateBinding Title}" VerticalAlignment="Center" TextWrapping="Wrap" TextTrimming="WordEllipsis"/>
                                <Button Margin="{StaticResource PopupWindowStyleMarginToken1}" Background="{DynamicResource PopupWindowStyleBackgroundToken1}" Name="CloseButton" Foreground="{DynamicResource PopupWindowStyleForegroundToken1}" Grid.Column="1" hc:BackgroundSwitchElement.MouseHoverBackground="{DynamicResource PopupWindowStyleMouseHoverBackgroundToken1}" hc:BackgroundSwitchElement.MouseDownBackground="{DynamicResource PopupWindowStyleMouseDownBackgroundToken1}" Command="interactivity:ControlCommands.Close" IsCancel="True" Height="{StaticResource PopupWindowStyleHeightToken2}" Style="{StaticResource ButtonCustom}" Width="{StaticResource PopupWindowStyleWidthToken1}" Padding="{StaticResource PopupWindowStylePaddingToken1}">
                                    <Path Fill="{Binding ElementName=CloseButton,Path=Foreground}" Style="{StaticResource ClosePathStyle}"/>
                                </Button>
                            </Grid>
                            <Border BorderBrush="{DynamicResource TitleBrush}" Name="PART_MainBorder" Grid.Row="1">
                                <StackPanel>
                                    <TextBlock Text="{TemplateBinding ContentStr}" MinHeight="{StaticResource PopupWindowStyleMinHeightToken2}" Name="MyTextBlock" TextAlignment="Center" Padding="{StaticResource PopupWindowStylePaddingToken2}" Foreground="{DynamicResource PrimaryTextBrush}" MaxWidth="{StaticResource PopupWindowStyleMaxWidthToken1}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" Background="{TemplateBinding Background}"/>
                                    <StackPanel Margin="{StaticResource PopupWindowStyleMarginToken2}" Orientation="Horizontal" Background="{DynamicResource RegionBrush}" HorizontalAlignment="Center">
                                        <Button IsCancel="True" MinWidth="{StaticResource PopupWindowStyleMinWidthToken2}" Command="interactivity:ControlCommands.Cancel" Content="{ex:Lang Key={x:Static langs:LangKeys.Cancel}}" Visibility="{TemplateBinding ShowCancel,Converter={StaticResource Boolean2VisibilityConverter}}" Margin="{StaticResource PopupWindowStyleMarginToken3}"/>
                                        <Button IsDefault="True" MinWidth="{StaticResource PopupWindowStyleMinWidthToken2}" Command="interactivity:ControlCommands.Confirm" Content="{ex:Lang Key={x:Static langs:LangKeys.Confirm}}" Style="{StaticResource ButtonPrimary}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="ShowBorder" Value="True">
                            <Setter Property="BorderThickness" Value="{StaticResource PopupWindowStyleBorderThicknessToken2}" TargetName="PART_MainBorder"/>
                        </Trigger>
                        <Trigger Property="ShowTitle" Value="False">
                            <Setter Property="Visibility" Value="Collapsed" TargetName="TitleGrid"/>
                            <Setter Property="Background" Value="{DynamicResource PopupWindowStyleBackgroundToken1}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
