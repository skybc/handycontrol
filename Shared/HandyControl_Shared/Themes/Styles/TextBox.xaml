<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:hc="clr-namespace:HandyControl.Controls">

    <Style BasedOn="{StaticResource WatermarkTextBoxBaseStyle}" TargetType="hc:WatermarkTextBox" />

    <Style BasedOn="{StaticResource TextBoxBaseStyle}" TargetType="TextBox" />

    <Style
        x:Key="TextBox.Small"
        BasedOn="{StaticResource TextBoxBaseStyle}"
        TargetType="TextBox">
        <Setter Property="MinHeight" Value="{DynamicResource SmallControlHeight}" />
        <Setter Property="Padding" Value="{StaticResource TextBoxStylePaddingToken1}" />
    </Style>

    <Style
        x:Key="TextBoxExtend"
        BasedOn="{StaticResource TextBoxExtendBaseStyle}"
        TargetType="TextBox" />

    <Style
        x:Key="TextBoxExtend.Small"
        BasedOn="{StaticResource TextBoxExtend}"
        TargetType="TextBox">
        <Setter Property="hc:InfoElement.MinContentHeight" Value="{DynamicResource SmallControlHeight}" />
        <Setter Property="hc:InfoElement.ContentHeight" Value="{DynamicResource SmallControlHeight}" />
        <Setter Property="hc:TitleElement.MarginOnTheLeft" Value="{StaticResource TextBoxStyleMarginOnTheLeftToken1}" />
        <Setter Property="hc:TitleElement.MarginOnTheTop" Value="{StaticResource TextBoxStyleMarginOnTheTopToken1}" />
        <Setter Property="Padding" Value="{StaticResource TextBoxStylePaddingToken1}" />
        <Setter Property="MinHeight" Value="{DynamicResource SmallControlHeight}" />
    </Style>

    <Style BasedOn="{StaticResource TextBoxPlusBaseStyle}" TargetType="hc:TextBox" />

    <Style
        x:Key="TextBoxPlus.Small"
        BasedOn="{StaticResource TextBoxPlusBaseStyle}"
        TargetType="hc:TextBox">
        <Setter Property="hc:InfoElement.MinContentHeight" Value="{StaticResource TextBoxStyleMinContentHeightToken1}" />
        <Setter Property="hc:InfoElement.ContentHeight" Value="{StaticResource TextBoxStyleContentHeightToken1}" />
        <Setter Property="hc:TitleElement.MarginOnTheLeft" Value="{StaticResource TextBoxStyleMarginOnTheLeftToken1}" />
        <Setter Property="hc:TitleElement.MarginOnTheTop" Value="{StaticResource TextBoxStyleMarginOnTheTopToken1}" />
        <Setter Property="Padding" Value="{StaticResource TextBoxStylePaddingToken1}" />
        <Setter Property="MinHeight" Value="{StaticResource TextBoxStyleMinHeightToken1}" />
    </Style>

</ResourceDictionary>
