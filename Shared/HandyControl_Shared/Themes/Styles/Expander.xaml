<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style BasedOn="{StaticResource ExpanderBaseStyle}" TargetType="Expander" />

    <Style x:Key="Expander.Small" BasedOn="{StaticResource ExpanderBaseStyle}" TargetType="Expander">
        <Setter Property="MinHeight" Value="{DynamicResource SmallControlHeight}" />
        <Setter Property="MinWidth" Value="{DynamicResource SmallControlHeight}" />
    </Style>

</ResourceDictionary>
