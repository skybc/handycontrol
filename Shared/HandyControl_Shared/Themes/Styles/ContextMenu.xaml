<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style BasedOn="{StaticResource ContextMenuBaseStyle}" TargetType="ContextMenu"/>

    <Style x:Key="ContextMenu.Small" BasedOn="{StaticResource ContextMenuBaseStyle}" TargetType="ContextMenu">
        <Setter Property="hc:MenuAttach.ItemPadding" Value="{StaticResource ContextMenuStyleItemPaddingToken1}" />
        <Setter Property="hc:MenuAttach.PopupVerticalOffset" Value="{StaticResource ContextMenuStylePopupVerticalOffsetToken1}" />
        <Setter Property="hc:MenuAttach.PopupHorizontalOffset" Value="{StaticResource ContextMenuStylePopupHorizontalOffsetToken1}" />
    </Style>

</ResourceDictionary>
