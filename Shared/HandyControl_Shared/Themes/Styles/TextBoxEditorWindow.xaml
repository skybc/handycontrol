<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:hc="clr-namespace:HandyControl.Controls"
    xmlns:interactivity="clr-namespace:HandyControl.Interactivity">

    <Style x:Key="TextBoxEditorWindowBaseStyle" TargetType="hc:TextBoxEditorWindow">
        <Setter Property="Background" Value="{DynamicResource RegionBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
        <Setter Property="ResizeMode" Value="CanResize" />
        <Setter Property="Width" Value="600" />
        <Setter Property="Height" Value="300" />
        <Setter Property="MinWidth" Value="500" />
        <Setter Property="MinHeight" Value="300" />
        <Setter Property="WindowTitle" Value="文本编辑器" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="hc:TextBoxEditorWindow">
                    <Border
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource DefaultCornerRadius}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!--  标题栏  -->
                            <Border
                                x:Name="PART_TitleBar"
                                Grid.Row="0"
                                Background="{DynamicResource SecondaryRegionBrush}"
                                CornerRadius="{StaticResource DefaultCornerRadius}">
                                <Grid Height="40">
                                    <TextBlock
                                        Margin="16,0"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        FontSize="14"
                                        FontWeight="Bold"
                                        Foreground="{DynamicResource PrimaryTextBrush}"
                                        Text="{TemplateBinding WindowTitle}" />

                                    <Button
                                        Width="40"
                                        Height="40"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        Command="interactivity:ControlCommands.Cancel"
                                        Content="✕"
                                        Foreground="{DynamicResource PrimaryTextBrush}"
                                        Style="{StaticResource ButtonIcon}" />
                                </Grid>
                            </Border>

                            <!--  主内容区  -->
                            <Grid Grid.Row="1" Margin="16">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="40" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <!--  第一行：编辑文本框  -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Border
                                        Grid.Column="0"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="{StaticResource DefaultCornerRadius}">
                                        <TextBox
                                            x:Name="PART_EditTextBox"
                                            Padding="8"
                                            VerticalAlignment="Center"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            FontFamily="Consolas"
                                            FontSize="14"
                                            HorizontalScrollBarVisibility="Auto"
                                            VerticalScrollBarVisibility="Hidden" />
                                    </Border>

                                    <Button
                                        Grid.Column="1"
                                        Width="40"
                                        Height="40"
                                        Margin="8,0,0,0"
                                        VerticalAlignment="Center"
                                        Command="interactivity:ControlCommands.Delete"
                                        Content="×"
                                        FontSize="20"
                                        Foreground="{DynamicResource PrimaryTextBrush}"
                                        Style="{StaticResource ButtonIcon}" />
                                </Grid>

                                <!--  第二行：变量按钮区  -->
                                <Border
                                    Grid.Row="1"
                                    Margin="0,12,0,0"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{StaticResource DefaultCornerRadius}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>

                                        <TextBlock
                                            Grid.Row="0"
                                            Margin="8"
                                            FontWeight="Bold"
                                            Foreground="{DynamicResource PrimaryTextBrush}"
                                            Text="可用变量" />

                                        <ScrollViewer
                                            Grid.Row="1"
                                            HorizontalScrollBarVisibility="Disabled"
                                            VerticalScrollBarVisibility="Auto">
                                            <WrapPanel x:Name="PART_VariableList" Margin="8" />
                                        </ScrollViewer>
                                    </Grid>
                                </Border>
                            </Grid>

                            <!--  底部按钮区  -->
                            <Border
                                Grid.Row="2"
                                Padding="16,12"
                                Background="{DynamicResource SecondaryRegionBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="0,1,0,0">
                                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                                    <Button
                                        Width="80"
                                        Margin="0,0,8,0"
                                        Command="interactivity:ControlCommands.Confirm"
                                        Content="确定"
                                        Style="{StaticResource ButtonPrimary}" />
                                    <Button
                                        Width="80"
                                        Command="interactivity:ControlCommands.Cancel"
                                        Content="取消"
                                        Style="{StaticResource ButtonDefault}" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style BasedOn="{StaticResource TextBoxEditorWindowBaseStyle}" TargetType="hc:TextBoxEditorWindow" />

</ResourceDictionary>
