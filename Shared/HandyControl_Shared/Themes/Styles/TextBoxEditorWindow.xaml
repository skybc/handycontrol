<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:hc="clr-namespace:HandyControl.Controls"
    xmlns:interactivity="clr-namespace:HandyControl.Interactivity">

    <Style x:Key="TextBoxEditorWindowBaseStyle" TargetType="hc:TextBoxEditorWindow">
        <Setter Property="Background" Value="{DynamicResource RegionBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
        <Setter Property="ResizeMode" Value="CanResize" />
        <Setter Property="Width" Value="{StaticResource TextBoxEditorWindowStyleWidthToken1}" />
        <Setter Property="Height" Value="{StaticResource TextBoxEditorWindowStyleHeightToken1}" />
        <Setter Property="MinWidth" Value="{StaticResource TextBoxEditorWindowStyleMinWidthToken1}" />
        <Setter Property="MinHeight" Value="{StaticResource TextBoxEditorWindowStyleMinHeightToken1}" />
        <Setter Property="WindowTitle" Value="文本编辑器" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="hc:TextBoxEditorWindow">
                    <Border
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{StaticResource TextBoxEditorWindowStyleBorderThicknessToken1}"
                        CornerRadius="{StaticResource DefaultCornerRadius}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!--  标题栏  -->
                            <Border
                                x:Name="PART_TitleBar"
                                Grid.Row="0"
                                Background="{DynamicResource SecondaryRegionBrush}"
                                CornerRadius="{StaticResource DefaultCornerRadius}">
                                <Grid Height="{StaticResource TextBoxEditorWindowStyleHeightToken2}">
                                    <TextBlock
                                        Margin="{StaticResource TextBoxEditorWindowStyleMarginToken1}"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        FontSize="{StaticResource TextBoxEditorWindowStyleFontSizeToken1}"
                                        FontWeight="Bold"
                                        Foreground="{DynamicResource PrimaryTextBrush}"
                                        Text="{TemplateBinding WindowTitle}" />

                                    <Button
                                        Width="{StaticResource TextBoxEditorWindowStyleWidthToken2}"
                                        Height="{StaticResource TextBoxEditorWindowStyleHeightToken2}"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        Command="interactivity:ControlCommands.Cancel"
                                        Content="✕"
                                        Foreground="{DynamicResource PrimaryTextBrush}"
                                        Style="{StaticResource ButtonIcon}" />
                                </Grid>
                            </Border>

                            <!--  主内容区  -->
                            <Grid Grid.Row="1" Margin="{StaticResource TextBoxEditorWindowStyleMarginToken2}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="{StaticResource TextBoxEditorWindowStyleHeightToken3}" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <!--  第一行：编辑文本框  -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Border
                                        Grid.Column="0"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="{StaticResource TextBoxEditorWindowStyleBorderThicknessToken1}"
                                        CornerRadius="{StaticResource DefaultCornerRadius}">
                                        <TextBox
                                            x:Name="PART_EditTextBox"
                                            Padding="{StaticResource TextBoxEditorWindowStylePaddingToken1}"
                                            VerticalAlignment="Center"
                                            Background="{DynamicResource TextBoxEditorWindowStyleBackgroundToken1}"
                                            BorderThickness="{StaticResource TextBoxEditorWindowStyleBorderThicknessToken2}"
                                            FontFamily="Consolas"
                                            FontSize="{StaticResource TextBoxEditorWindowStyleFontSizeToken1}"
                                            HorizontalScrollBarVisibility="Auto"
                                            VerticalScrollBarVisibility="Hidden" />
                                    </Border>

                                    <Button
                                        Grid.Column="1"
                                        Width="{StaticResource TextBoxEditorWindowStyleWidthToken2}"
                                        Height="{StaticResource TextBoxEditorWindowStyleHeightToken2}"
                                        Margin="{StaticResource TextBoxEditorWindowStyleMarginToken3}"
                                        VerticalAlignment="Center"
                                        Command="interactivity:ControlCommands.Delete"
                                        Content="×"
                                        FontSize="{StaticResource TextBoxEditorWindowStyleFontSizeToken2}"
                                        Foreground="{DynamicResource PrimaryTextBrush}"
                                        Style="{StaticResource ButtonIcon}" />
                                </Grid>

                                <!--  第二行：变量按钮区  -->
                                <Border
                                    Grid.Row="1"
                                    Margin="{StaticResource TextBoxEditorWindowStyleMarginToken4}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="{StaticResource TextBoxEditorWindowStyleBorderThicknessToken1}"
                                    CornerRadius="{StaticResource DefaultCornerRadius}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>

                                        <TextBlock
                                            Grid.Row="0"
                                            Margin="{StaticResource TextBoxEditorWindowStyleMarginToken5}"
                                            FontWeight="Bold"
                                            Foreground="{DynamicResource PrimaryTextBrush}"
                                            Text="可用变量" />

                                        <ScrollViewer
                                            Grid.Row="1"
                                            HorizontalScrollBarVisibility="Disabled"
                                            VerticalScrollBarVisibility="Auto">
                                            <WrapPanel x:Name="PART_VariableList" Margin="{StaticResource TextBoxEditorWindowStyleMarginToken5}" />
                                        </ScrollViewer>
                                    </Grid>
                                </Border>
                            </Grid>

                            <!--  底部按钮区  -->
                            <Border
                                Grid.Row="2"
                                Padding="{StaticResource TextBoxEditorWindowStylePaddingToken2}"
                                Background="{DynamicResource SecondaryRegionBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="{StaticResource TextBoxEditorWindowStyleBorderThicknessToken3}">
                                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                                    <Button
                                        Width="{StaticResource TextBoxEditorWindowStyleWidthToken3}"
                                        Margin="{StaticResource TextBoxEditorWindowStyleMarginToken6}"
                                        Command="interactivity:ControlCommands.Confirm"
                                        Content="确定"
                                        Style="{StaticResource ButtonPrimary}" />
                                    <Button
                                        Width="{StaticResource TextBoxEditorWindowStyleWidthToken3}"
                                        Command="interactivity:ControlCommands.Cancel"
                                        Content="取消"
                                        Style="{StaticResource ButtonDefault}" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style BasedOn="{StaticResource TextBoxEditorWindowBaseStyle}" TargetType="hc:TextBoxEditorWindow" />

</ResourceDictionary>
