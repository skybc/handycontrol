<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:hc="clr-namespace:HandyControl.Controls">

    <Style x:Key="MaskRect4ScreenshotStyle" TargetType="Rectangle">
        <Setter Property="IsHitTestVisible" Value="False"/>
        <Setter Property="Fill" Value="{DynamicResource DarkOpacityBrush}"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="VerticalAlignment" Value="Top"/>
    </Style>

    <Style x:Key="SnapRect4ScreenshotStyle" TargetType="Rectangle">
        <Setter Property="Height" Value="{StaticResource ScreenshotStyleHeightToken1}"/>
        <Setter Property="Width" Value="{StaticResource ScreenshotStyleWidthToken1}"/>
        <Setter Property="Fill" Value="{DynamicResource ScreenshotStyleFillToken2}"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="VerticalAlignment" Value="Top"/>
        <Setter Property="Visibility" Value="Collapsed"/>
        <Style.Triggers>
            <Trigger Property="hc:TipElement.Placement" Value="LeftTop">
                <Setter Property="Margin" Value="{StaticResource ScreenshotStyleMarginToken1}"/>
                <Setter Property="HorizontalAlignment" Value="Left"/>
                <Setter Property="VerticalAlignment" Value="Top"/>
            </Trigger>
            <Trigger Property="hc:TipElement.Placement" Value="Top">
                <Setter Property="Margin" Value="{StaticResource ScreenshotStyleMarginToken2}"/>
                <Setter Property="HorizontalAlignment" Value="Center"/>
                <Setter Property="VerticalAlignment" Value="Top"/>
            </Trigger>
            <Trigger Property="hc:TipElement.Placement" Value="RightTop">
                <Setter Property="Margin" Value="{StaticResource ScreenshotStyleMarginToken3}"/>
                <Setter Property="HorizontalAlignment" Value="Right"/>
                <Setter Property="VerticalAlignment" Value="Top"/>
            </Trigger>
            <Trigger Property="hc:TipElement.Placement" Value="Right">
                <Setter Property="Margin" Value="{StaticResource ScreenshotStyleMarginToken4}"/>
                <Setter Property="HorizontalAlignment" Value="Right"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Trigger>
            <Trigger Property="hc:TipElement.Placement" Value="RightBottom">
                <Setter Property="Margin" Value="{StaticResource ScreenshotStyleMarginToken5}"/>
                <Setter Property="HorizontalAlignment" Value="Right"/>
                <Setter Property="VerticalAlignment" Value="Bottom"/>
            </Trigger>
            <Trigger Property="hc:TipElement.Placement" Value="Bottom">
                <Setter Property="Margin" Value="{StaticResource ScreenshotStyleMarginToken6}"/>
                <Setter Property="HorizontalAlignment" Value="Center"/>
                <Setter Property="VerticalAlignment" Value="Bottom"/>
            </Trigger>
            <Trigger Property="hc:TipElement.Placement" Value="LeftBottom">
                <Setter Property="Margin" Value="{StaticResource ScreenshotStyleMarginToken7}"/>
                <Setter Property="HorizontalAlignment" Value="Left"/>
                <Setter Property="VerticalAlignment" Value="Bottom"/>
            </Trigger>
            <Trigger Property="hc:TipElement.Placement" Value="Left">
                <Setter Property="Margin" Value="{StaticResource ScreenshotStyleMarginToken8}"/>
                <Setter Property="HorizontalAlignment" Value="Left"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Trigger>
            <DataTrigger Binding="{Binding IsSelecting}" Value="True">
                <Setter Property="Visibility" Value="Visible"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding IsDrawing}" Value="True">
                <Setter Property="Visibility" Value="Visible"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="TargetArea4ScreenshotStyle" TargetType="Border">
        <Setter Property="IsHitTestVisible" Value="False"/>
        <Setter Property="BorderThickness" Value="{StaticResource ScreenshotStyleBorderThicknessToken1}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ScreenshotStyleBorderBrushToken3}"/>
        <Setter Property="Background" Value="{DynamicResource ScreenshotStyleBackgroundToken1}"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="VerticalAlignment" Value="Top"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsSelecting}" Value="True">
                <Setter Property="BorderThickness" Value="{StaticResource ScreenshotStyleBorderThicknessToken2}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding IsDrawing}" Value="True">
                <Setter Property="IsHitTestVisible" Value="True"/>
                <Setter Property="BorderThickness" Value="{StaticResource ScreenshotStyleBorderThicknessToken2}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Window4ScreenshotStyle" TargetType="hc:ScreenshotWindow">
        <Setter Property="UseLayoutRounding" Value="True"/>
        <Setter Property="WindowStyle" Value="None"/>
        <Setter Property="WindowState" Value="Maximized"/>
        <Setter Property="Topmost" Value="True"/>
        <Setter Property="ResizeMode" Value="NoResize"/>
        <Setter Property="Background" Value="{DynamicResource ScreenshotStyleBackgroundToken1}"/>
        <Setter Property="hc:WindowAttach.IgnoreAltF4" Value="True"/>
        <Setter Property="hc:WindowAttach.ShowInTaskManager" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="hc:ScreenshotWindow">
                    <AdornerDecorator>
                        <hc:SimplePanel>
                            <InkCanvas EditingMode="None" Name="PART_Canvas" Background="{DynamicResource ScreenshotStyleBackgroundToken1}"/>
                            <Rectangle Name="PART_MaskAreaLeft" Style="{StaticResource MaskRect4ScreenshotStyle}"/>
                            <Rectangle Name="PART_MaskAreaTop" Style="{StaticResource MaskRect4ScreenshotStyle}"/>
                            <Rectangle Name="PART_MaskAreaRight" Style="{StaticResource MaskRect4ScreenshotStyle}"/>
                            <Rectangle Name="PART_MaskAreaBottom" Style="{StaticResource MaskRect4ScreenshotStyle}"/>
                            <Border Name="PART_TargetArea" Style="{StaticResource TargetArea4ScreenshotStyle}">
                                <hc:SimplePanel>
                                    <Rectangle hc:TipElement.Placement="LeftTop" Style="{StaticResource SnapRect4ScreenshotStyle}"/>
                                    <Rectangle hc:TipElement.Placement="Top" Style="{StaticResource SnapRect4ScreenshotStyle}"/>
                                    <Rectangle hc:TipElement.Placement="RightTop" Style="{StaticResource SnapRect4ScreenshotStyle}"/>
                                    <Rectangle hc:TipElement.Placement="Right" Style="{StaticResource SnapRect4ScreenshotStyle}"/>
                                    <Rectangle hc:TipElement.Placement="RightBottom" Style="{StaticResource SnapRect4ScreenshotStyle}"/>
                                    <Rectangle hc:TipElement.Placement="Bottom" Style="{StaticResource SnapRect4ScreenshotStyle}"/>
                                    <Rectangle hc:TipElement.Placement="LeftBottom" Style="{StaticResource SnapRect4ScreenshotStyle}"/>
                                    <Rectangle hc:TipElement.Placement="Left" Style="{StaticResource SnapRect4ScreenshotStyle}"/>
                                    <TextBlock Text="{TemplateBinding SizeStr}" Background="{DynamicResource ScreenshotStyleBackgroundToken2}" Foreground="{DynamicResource ScreenshotStyleForegroundToken1}" HorizontalAlignment="Left" VerticalAlignment="Top" Padding="{StaticResource ScreenshotStylePaddingToken1}"/>
                                </hc:SimplePanel>
                            </Border>
                            <Border x:Name="PART_Magnifier" IsHitTestVisible="False" Visibility="Collapsed" HorizontalAlignment="Left" VerticalAlignment="Top" Width="{StaticResource ScreenshotStyleWidthToken2}" Height="{StaticResource ScreenshotStyleHeightToken2}" BorderThickness="{StaticResource ScreenshotStyleBorderThicknessToken2}" BorderBrush="{DynamicResource ScreenshotStyleBorderBrushToken1}" CornerRadius="{StaticResource ScreenshotStyleCornerRadiusToken1}">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="{StaticResource ScreenshotStyleBlurRadiusToken1}" Opacity=".2" Direction="-45" RenderingBias="Performance" ShadowDepth="{StaticResource ScreenshotStyleShadowDepthToken1}"/>
                                </Border.Effect>
                                <hc:SimplePanel>
                                    <Border Margin="{StaticResource ScreenshotStyleMarginToken9}" Background="{TemplateBinding PreviewBrush}" BorderThickness="{StaticResource ScreenshotStyleBorderThicknessToken3}" BorderBrush="{DynamicResource ScreenshotStyleBorderBrushToken2}">
                                        <hc:SimplePanel>
                                            <Path Data="M56,0 L60,0 60,40 116,40 116,44 60,44 60,84 56,84 56,44 0,44 0,40 56,40 z" Fill="{DynamicResource ScreenshotStyleFillToken1}"/>
                                        </hc:SimplePanel>
                                    </Border>
                                    <Border Height="{StaticResource ScreenshotStyleHeightToken3}" VerticalAlignment="Bottom" Background="{DynamicResource ScreenshotStyleBackgroundToken3}">
                                        <StackPanel VerticalAlignment="Center" Margin="{StaticResource ScreenshotStyleMarginToken10}">
                                            <TextBlock Foreground="{DynamicResource ScreenshotStyleForegroundToken1}" Text="{TemplateBinding SizeStr}"/>
                                        </StackPanel>
                                    </Border>
                                </hc:SimplePanel>
                            </Border>
                        </hc:SimplePanel>
                    </AdornerDecorator>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
