<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:system="clr-namespace:System;assembly=mscorlib">
  <!-- StandardLight semantic palette: solid colors only. -->
  <Color x:Key="LightPrimaryColor">#EAF2FF</Color>
  <Color x:Key="PrimaryColor">#1677FF</Color>
  <Color x:Key="DarkPrimaryColor">#0958D9</Color>
  <Color x:Key="LightDangerColor">#FFF1F0</Color>
  <Color x:Key="DangerColor">#D9363E</Color>
  <Color x:Key="DarkDangerColor">#B4232D</Color>
  <Color x:Key="LightWarningColor">#FFF7E6</Color>
  <Color x:Key="WarningColor">#D48806</Color>
  <Color x:Key="DarkWarningColor">#AD6800</Color>
  <Color x:Key="LightInfoColor">#E6F7FF</Color>
  <Color x:Key="InfoColor">#1890FF</Color>
  <Color x:Key="DarkInfoColor">#096DD9</Color>
  <Color x:Key="LightSuccessColor">#F0FFF4</Color>
  <Color x:Key="SuccessColor">#22A06B</Color>
  <Color x:Key="DarkSuccessColor">#16855A</Color>
  <Color x:Key="PrimaryTextColor">#1F2329</Color>
  <Color x:Key="SecondaryTextColor">#646A73</Color>
  <Color x:Key="ThirdlyTextColor">#A8ADB5</Color>
