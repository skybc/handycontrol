<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:system="clr-namespace:System;assembly=mscorlib">
  <!-- StandardLight semantic palette: solid colors only. -->
  <Color x:Key="LightPrimaryColor">#EFF6FF</Color>
  <Color x:Key="PrimaryColor">#2563EB</Color>
  <Color x:Key="DarkPrimaryColor">#1D4ED8</Color>
  <Color x:Key="LightDangerColor">#FEF2F2</Color>
  <Color x:Key="DangerColor">#DC2626</Color>
  <Color x:Key="DarkDangerColor">#B91C1C</Color>
  <Color x:Key="LightWarningColor">#FFFBEB</Color>
  <Color x:Key="WarningColor">#F59E0B</Color>
  <Color x:Key="DarkWarningColor">#B45309</Color>
  <Color x:Key="LightInfoColor">#ECFEFF</Color>
  <Color x:Key="InfoColor">#0891B2</Color>
  <Color x:Key="DarkInfoColor">#0E7490</Color>
  <Color x:Key="LightSuccessColor">#ECFDF5</Color>
  <Color x:Key="SuccessColor">#059669</Color>
  <Color x:Key="DarkSuccessColor">#047857</Color>
  <Color x:Key="PrimaryTextColor">#334155</Color>
  <Color x:Key="SecondaryTextColor">#64748B</Color>
  <Color x:Key="ThirdlyTextColor">#94A3B8</Color>
  <Color x:Key="ReverseTextColor">#FFFFFF</Color>
  <Color x:Key="TextIconColor">#FFFFFF</Color>
  <Color x:Key="BorderColor">#E2E8F0</Color>
  <Color x:Key="SecondaryBorderColor">#CBD5E1</Color>
  <Color x:Key="BackgroundColor">#F8FAFC</Color>
  <Color x:Key="RegionColor">#FFFFFF</Color>
  <Color x:Key="SecondaryRegionColor">#F1F5F9</Color>
  <Color x:Key="ThirdlyRegionColor">#F1F5F9</Color>
  <Color x:Key="TitleColor">#2563EB</Color>
  <Color x:Key="SecondaryTitleColor">#1D4ED8</Color>
  <Color x:Key="DefaultColor">#FFFFFF</Color>
  <Color x:Key="DarkDefaultColor">#F1F5F9</Color>
  <Color x:Key="AccentColor">#2563EB</Color>
  <Color x:Key="DarkAccentColor">#1D4ED8</Color>

  <!-- Additional StandardLight tokens not supplied by the shared palette. -->
  <Color x:Key="TitleTextColor">#0F172A</Color>
  <Color x:Key="NavigationBackgroundColor">#0F172A</Color>
  <Color x:Key="NavigationForegroundColor">#CBD5E1</Color>
  <Color x:Key="NavigationSeparatorColor">#334155</Color>
  <Color x:Key="LightDisabledColor">#F1F5F9</Color>
  <Color x:Key="DisabledColor">#94A3B8</Color>
  <Color x:Key="DarkDisabledColor">#64748B</Color>
  <SolidColorBrush x:Key="PrimaryBrush" Color="{DynamicResource PrimaryColor}" />
  <SolidColorBrush x:Key="DarkPrimaryBrush" Color="{DynamicResource DarkPrimaryColor}" />
  <SolidColorBrush x:Key="TitleBrush" Color="{DynamicResource TitleColor}" />
  <SolidColorBrush x:Key="DangerBrush" Color="{DynamicResource DangerColor}" />
  <SolidColorBrush x:Key="DarkDangerBrush" Color="{DynamicResource DarkDangerColor}" />
  <SolidColorBrush x:Key="WarningBrush" Color="{DynamicResource WarningColor}" />
  <SolidColorBrush x:Key="DarkWarningBrush" Color="{DynamicResource DarkWarningColor}" />
  <SolidColorBrush x:Key="InfoBrush" Color="{DynamicResource InfoColor}" />
  <SolidColorBrush x:Key="DarkInfoBrush" Color="{DynamicResource DarkInfoColor}" />
  <SolidColorBrush x:Key="SuccessBrush" Color="{DynamicResource SuccessColor}" />
  <SolidColorBrush x:Key="DarkSuccessBrush" Color="{DynamicResource DarkSuccessColor}" />
  <SolidColorBrush x:Key="LightDisabledBrush" Color="{DynamicResource LightDisabledColor}" />
  <SolidColorBrush x:Key="DisabledBrush" Color="{DynamicResource DisabledColor}" />
  <SolidColorBrush x:Key="DarkDisabledBrush" Color="{DynamicResource DarkDisabledColor}" />
  <SolidColorBrush x:Key="TitleTextBrush" Color="{DynamicResource TitleTextColor}" />
  <SolidColorBrush x:Key="NavigationBackgroundBrush" Color="{DynamicResource NavigationBackgroundColor}" />
  <SolidColorBrush x:Key="NavigationForegroundBrush" Color="{DynamicResource NavigationForegroundColor}" />
  <SolidColorBrush x:Key="NavigationSeparatorBrush" Color="{DynamicResource NavigationSeparatorColor}" />
  <Color x:Key="DarkMaskColor">#33000000</Color>
  <Color x:Key="DarkOpacityColor">#66000000</Color>
  <system:UInt32 x:Key="BlurGradientValue">0x99FFFFFF</system:UInt32>
</ResourceDictionary>
