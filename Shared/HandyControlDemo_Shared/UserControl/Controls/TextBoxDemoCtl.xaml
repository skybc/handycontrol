<UserControl
    x:Class="HandyControlDemo.UserControl.TextBoxDemoCtl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ex="clr-namespace:HandyControlDemo.Tools.Extension"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:langs="clr-namespace:HandyControlDemo.Properties.Langs"
    Background="{DynamicResource RegionBrush}"
    DataContext="{Binding InputElementDemo, Source={StaticResource Locator}}">
    <hc:TransitioningContentControl>
        <hc:ScrollViewer IsInertiaEnabled="True">
            <hc:UniformSpacingPanel
                Margin="32"
                ChildWrapping="Wrap"
                Spacing="32">
                <StackPanel>
                    <hc:TextBox
                        hc:BorderElement.CornerRadius="0"
                        hc:InfoElement.ShowClearButton="True"
                        Icon="/HandyControlDemo;component/Resources/Img/Dance.png"
                        IconButtnBorderBrush="Black"
                        IconButtnCornerRadius="0"
                        ShowIcon="Visible"
                        Style="{StaticResource TextBoxPlusBaseStyle}"
                        Text="{ex:Lang Key={x:Static langs:LangKeys.ContentDemoStr}}" />
                    <hc:TextBox
                        Margin="0,16,0,0"
                        IsEnabled="False"
                        Text="{ex:Lang Key={x:Static langs:LangKeys.ContentDemoStr}}" />

                    <hc:TextBox
                        Margin="0,32,0,0"
                        hc:InfoElement.ShowClearButton="True"
                        hc:InfoElement.Title="{ex:Lang Key={x:Static langs:LangKeys.TitleDemoStr1}}"
                        Text="{ex:Lang Key={x:Static langs:LangKeys.ContentDemoStr}}" />
                    <hc:TextBox
                        Margin="0,16,0,0"
                        hc:InfoElement.Necessary="True"
                        hc:InfoElement.Placeholder="{ex:Lang Key={x:Static langs:LangKeys.PlsEnterEmail}}"
                        hc:InfoElement.Title="{ex:Lang Key={x:Static langs:LangKeys.TitleDemoStr2}}">
                        <hc:TextBox.Text>
                            <Binding Path="Email1" UpdateSourceTrigger="PropertyChanged">
                                <Binding.ValidationRules>
                                    <hc:RegexRule Type="Mail" />
                                </Binding.ValidationRules>
                            </Binding>
                        </hc:TextBox.Text>
                    </hc:TextBox>
                    <hc:TextBox
                        Width="380"
                        Margin="0,32,0,0"
                        hc:InfoElement.Title="{ex:Lang Key={x:Static langs:LangKeys.TitleDemoStr3}}"
                        hc:InfoElement.TitlePlacement="Left"
                        hc:InfoElement.TitleWidth="140"
                        Text="{ex:Lang Key={x:Static langs:LangKeys.ContentDemoStr}}" />
                    <hc:TextBox
                        Width="380"
                        Margin="0,16,0,0"
                        hc:InfoElement.Necessary="True"
                        hc:InfoElement.Placeholder="{ex:Lang Key={x:Static langs:LangKeys.PlsEnterContent}}"
                        hc:InfoElement.ShowClearButton="True"
                        hc:InfoElement.Title="{ex:Lang Key={x:Static langs:LangKeys.TitleDemoStr3}}"
                        hc:InfoElement.TitlePlacement="Left"
                        hc:InfoElement.TitleWidth="140" />
                </StackPanel>
                <StackPanel>
                    <hc:TextBox
                        hc:InfoElement.ShowClearButton="True"
                        Style="{StaticResource TextBoxPlus.Small}"
                        Text="{ex:Lang Key={x:Static langs:LangKeys.ContentDemoStr}}" />
                    <hc:TextBox
                        Margin="0,16,0,0"
                        IsEnabled="False"
                        Style="{StaticResource TextBoxPlus.Small}"
                        Text="{ex:Lang Key={x:Static langs:LangKeys.ContentDemoStr}}" />

                    <hc:TextBox
                        Margin="0,32,0,0"
                        hc:InfoElement.ShowClearButton="True"
                        hc:InfoElement.Title="{ex:Lang Key={x:Static langs:LangKeys.TitleDemoStr1}}"
                        Style="{StaticResource TextBoxPlus.Small}"
                        Text="{ex:Lang Key={x:Static langs:LangKeys.ContentDemoStr}}" />
                    <hc:TextBox
                        Margin="0,16,0,0"
                        hc:InfoElement.Necessary="True"
                        hc:InfoElement.Placeholder="{ex:Lang Key={x:Static langs:LangKeys.PlsEnterEmail}}"
                        hc:InfoElement.Title="{ex:Lang Key={x:Static langs:LangKeys.TitleDemoStr2}}"
                        Style="{StaticResource TextBoxPlus.Small}">
                        <hc:TextBox.Text>
                            <Binding Path="Email2" UpdateSourceTrigger="PropertyChanged">
                                <Binding.ValidationRules>
                                    <hc:RegexRule Type="Mail" />
                                </Binding.ValidationRules>
                            </Binding>
                        </hc:TextBox.Text>
                    </hc:TextBox>
                    <hc:TextBox
                        Width="380"
                        Margin="0,32,0,0"
                        hc:InfoElement.Title="{ex:Lang Key={x:Static langs:LangKeys.TitleDemoStr3}}"
                        hc:InfoElement.TitlePlacement="Left"
                        hc:InfoElement.TitleWidth="140"
                        Style="{StaticResource TextBoxPlus.Small}"
                        Text="{ex:Lang Key={x:Static langs:LangKeys.ContentDemoStr}}" />
                    <hc:TextBox
                        Width="380"
                        Margin="0,16,0,0"
                        hc:InfoElement.Necessary="True"
                        hc:InfoElement.Placeholder="{ex:Lang Key={x:Static langs:LangKeys.PlsEnterContent}}"
                        hc:InfoElement.ShowClearButton="True"
                        hc:InfoElement.Title="{ex:Lang Key={x:Static langs:LangKeys.TitleDemoStr3}}"
                        hc:InfoElement.TitlePlacement="Left"
                        hc:InfoElement.TitleWidth="140"
                        Style="{StaticResource TextBoxPlus.Small}" />
                </StackPanel>
            </hc:UniformSpacingPanel>
        </hc:ScrollViewer>
    </hc:TransitioningContentControl>
</UserControl>
