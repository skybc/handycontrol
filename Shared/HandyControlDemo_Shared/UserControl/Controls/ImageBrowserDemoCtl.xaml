<UserControl
    x:Class="HandyControlDemo.UserControl.ImageBrowserDemoCtl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ex="clr-namespace:HandyControlDemo.Tools.Extension"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:langs="clr-namespace:HandyControlDemo.Properties.Langs"
    Background="{DynamicResource RegionBrush}"
    DataContext="{Binding ImageBrowserDemo, Source={StaticResource Locator}}">
    <hc:TransitioningContentControl>
        <StackPanel Margin="32">
            <hc:ImageViewer
                Height="330"
                MaxWidth="600"
                Background="{DynamicResource SecondaryRegionBrush}"
                ImageSource="/HandyControlDemo;component/Resources/Img/1.jpg" />
            <Button
                Margin="0,32,0,0"
                HorizontalAlignment="Center"
                Command="{Binding OpenImgCmd}"
                Content="{ex:Lang Key={x:Static langs:LangKeys.OpenImageBrowser}}"
                Style="{StaticResource ButtonPrimary}" />

           
        </StackPanel>
    </hc:TransitioningContentControl>
</UserControl>
