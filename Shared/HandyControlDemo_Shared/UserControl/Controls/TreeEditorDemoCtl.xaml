<UserControl x:Class="HandyControlDemo.UserControl.TreeEditorDemoCtl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             Background="{DynamicResource RegionBrush}">
    <hc:TransitioningContentControl>
        <hc:ScrollViewer IsInertiaEnabled="True">
            <hc:UniformSpacingPanel Spacing="32" Margin="32" ChildWrapping="Wrap">
                <StackPanel Width="500">
                    <TextBlock Text="TreeEditor 目录树编辑器" 
                              Style="{StaticResource TextBlockTitle}" 
                              Margin="0,0,0,16"/>
                    
                    <hc:TreeEditor x:Name="TreeEditor1"
                                  hc:InfoElement.Title="文件路径"
                                  hc:InfoElement.TitlePlacement="Left"
                                  hc:InfoElement.TitleWidth="100"
                                  Path="{Binding TreePath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  Variables="{Binding Variables}"
                                  Margin="0,0,0,16"/>

                    <hc:TreeEditor x:Name="TreeEditor2"
                                  hc:InfoElement.Title="目录结构"
                                  hc:InfoElement.Necessary="True"
                                  Path="{Binding DirectoryPath, Mode=TwoWay}"
                                  Variables="{Binding Variables}"
                                  Margin="0,16,0,0"/>

                    <hc:Divider Margin="0,32,0,16"/>

                    <TextBlock Text="编辑结果预览：" 
                              FontWeight="Bold" 
                              Margin="0,0,0,8"/>
                    
                    <Border BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource DefaultCornerRadius}"
                            Background="{DynamicResource SecondaryRegionBrush}"
                            Padding="12"
                            MinHeight="100">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            
                            <StackPanel Grid.Row="0" Margin="0,0,0,12">
                                <TextBlock Text="文件路径：" 
                                          FontWeight="SemiBold"
                                          Foreground="{DynamicResource PrimaryTextBrush}"
                                          Margin="0,0,0,4"/>
                                <TextBlock Text="{Binding TreePath}" 
                                          TextWrapping="Wrap"
                                          FontFamily="Consolas"
                                          FontSize="12"
                                          Foreground="{DynamicResource SuccessBrush}"/>
                            </StackPanel>
                            
                            <StackPanel Grid.Row="1">
                                <TextBlock Text="目录结构：" 
                                          FontWeight="SemiBold"
                                          Foreground="{DynamicResource PrimaryTextBrush}"
                                          Margin="0,0,0,4"/>
                                <TextBlock Text="{Binding DirectoryPath}" 
                                          TextWrapping="Wrap"
                                          FontFamily="Consolas"
                                          FontSize="12"
                                          Foreground="{DynamicResource SuccessBrush}"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>

                <StackPanel Width="400">
                    <TextBlock Text="可用变量列表" 
                              Style="{StaticResource TextBlockTitle}" 
                              Margin="0,0,0,16"/>

                    <ItemsControl ItemsSource="{Binding Variables}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{DynamicResource BorderBrush}"
                                       BorderThickness="1"
                                       CornerRadius="{StaticResource DefaultCornerRadius}"
                                       Background="{DynamicResource RegionBrush}"
                                       Padding="8,4"
                                       Margin="0,4">
                                    <TextBlock Text="{Binding}" FontFamily="Consolas"/>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <hc:Divider Margin="0,32,0,16"/>

                    <TextBlock Text="使用说明：" 
                              FontWeight="Bold" 
                              Margin="0,0,0,8"/>
                    <TextBlock TextWrapping="Wrap" 
                              Foreground="{DynamicResource SecondaryTextBrush}">
                        1. 点击文本框右侧的"..."按钮打开编辑器<LineBreak/>
                        2. 在编辑器中查看和编辑目录树结构<LineBreak/>
                        3. 点击工具栏的"+"按钮新增子节点<LineBreak/>
                        4. 点击工具栏的"删除"按钮删除选中节点<LineBreak/>
                        5. 双击右侧变量列表中的变量插入到选中节点<LineBreak/>
                        6. 变量格式为 {变量名}<LineBreak/>
                        7. 节点文本可直接编辑<LineBreak/>
                        8. 点击"确定"保存编辑结果，结果以 \ 分隔
                    </TextBlock>
                </StackPanel>
            </hc:UniformSpacingPanel>
        </hc:ScrollViewer>
    </hc:TransitioningContentControl>
</UserControl>
