<UserControl x:Class="HandyControlDemo.UserControl.GeometryViewDemoCtl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             Background="{DynamicResource RegionBrush}">
    <hc:TransitioningContentControl>
        <ScrollViewer>
            <StackPanel Margin="32">
                <!-- 标题 -->
                <TextBlock Text="GeometryView - 矢量图形控件" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}" Margin="0,0,0,16"/>
                
                <!-- 基础示例 -->
                <GroupBox Header="基础示例（从 PathGeometry 字符串解析）" hc:BorderElement.CornerRadius="4" Margin="0,0,0,16">
                    <StackPanel Margin="16">
                        <TextBlock Text="简单圆形" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <hc:GeometryView Height="48" Width="48" 
                                        Geometry="M 24,2 A 22,22 0 0,1 24,46 A 22,22 0 0,1 24,2 Z"
                                        Foreground="{DynamicResource PrimaryBrush}"/>
                        
                        <Separator Margin="0,16,0,8"/>
                        
                        <TextBlock Text="五角星" FontSize="14" FontWeight="SemiBold" Margin="0,8,0,8"/>
                        <hc:GeometryView Height="64" Width="64"
                                        Geometry="M535.9 165.2l96.5 195.4c3.9 7.9 11.4 13.3 20.1 14.6l215.7 31.3c21.9 3.2 30.6 30 14.8 45.5L726.8 604.1c-6.3 6.1-9.1 14.9-7.7 23.6L756 842.5c3.7 21.8-19.1 38.4-38.7 28.1L524.4 769.2c-7.8-4.1-17-4.1-24.8 0L306.7 870.6c-19.6 10.3-42.4-6.3-38.7-28.1l36.8-214.8c1.5-8.6-1.4-17.5-7.7-23.6L141.1 452c-15.8-15.4-7.1-42.3 14.8-45.5l215.7-31.3c8.7-1.3 16.2-6.7 20.1-14.6l96.5-195.4c9.7-19.9 37.9-19.9 47.7 0z"
                                        Foreground="{DynamicResource SuccessBrush}"/>
                    </StackPanel>
                </GroupBox>

                <!-- 颜色变化示例 -->
                <GroupBox Header="颜色与尺寸变化" hc:BorderElement.CornerRadius="4" Margin="0,0,0,16">
                    <StackPanel Margin="16">
                        <TextBlock Text="不同前景色示例" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,16"/>
                        <StackPanel Orientation="Horizontal">
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Text="Primary" FontSize="12" Margin="0,0,0,8"/>
                                <hc:GeometryView Height="40" Width="40"
                                                Geometry="M 24,2 A 22,22 0 0,1 24,46 A 22,22 0 0,1 24,2 Z"
                                                Foreground="{DynamicResource PrimaryBrush}"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Text="Success" FontSize="12" Margin="0,0,0,8"/>
                                <hc:GeometryView Height="40" Width="40"
                                                Geometry="M 24,2 A 22,22 0 0,1 24,46 A 22,22 0 0,1 24,2 Z"
                                                Foreground="{DynamicResource SuccessBrush}"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Text="Warning" FontSize="12" Margin="0,0,0,8"/>
                                <hc:GeometryView Height="40" Width="40"
                                                Geometry="M 24,2 A 22,22 0 0,1 24,46 A 22,22 0 0,1 24,2 Z"
                                                Foreground="{DynamicResource WarningBrush}"/>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="Danger" FontSize="12" Margin="0,0,0,8"/>
                                <hc:GeometryView Height="40" Width="40"
                                                Geometry="M 24,2 A 22,22 0 0,1 24,46 A 22,22 0 0,1 24,2 Z"
                                                Foreground="{DynamicResource DangerBrush}"/>
                            </StackPanel>
                        </StackPanel>

                        <Separator Margin="0,16,0,8"/>
                        
                        <TextBlock Text="不同尺寸示例（通过 FontSize 缩放）" FontSize="14" FontWeight="SemiBold" Margin="0,8,0,16"/>
                        <StackPanel Orientation="Horizontal">
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Text="FontSize=12" FontSize="12" Margin="0,0,0,8"/>
                                <hc:GeometryView Height="24" Width="24" FontSize="12"
                                                Geometry="M 24,2 A 22,22 0 0,1 24,46 A 22,22 0 0,1 24,2 Z"
                                                Foreground="{DynamicResource PrimaryBrush}"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Text="FontSize=24" FontSize="12" Margin="0,0,0,8"/>
                                <hc:GeometryView Height="48" Width="48" FontSize="24"
                                                Geometry="M 24,2 A 22,22 0 0,1 24,46 A 22,22 0 0,1 24,2 Z"
                                                Foreground="{DynamicResource PrimaryBrush}"/>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="FontSize=36" FontSize="12" Margin="0,0,0,8"/>
                                <hc:GeometryView Height="72" Width="72" FontSize="36"
                                                Geometry="M 24,2 A 22,22 0 0,1 24,46 A 22,22 0 0,1 24,2 Z"
                                                Foreground="{DynamicResource PrimaryBrush}"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </GroupBox>

                <!-- 错误处理示例 -->
                <GroupBox Header="错误处理与边界情况" hc:BorderElement.CornerRadius="4" Margin="0,0,0,16">
                    <StackPanel Margin="16">
                        <TextBlock Text="空字符串 - 应显示空白" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <Border Background="{DynamicResource BorderBrush}" Height="50" Width="50">
                            <hc:GeometryView Geometry=""/>
                        </Border>
                        
                        <TextBlock Text="无效的几何字符串 - 应显示空白（不抛出异常）" FontSize="14" FontWeight="SemiBold" Margin="0,16,0,8"/>
                        <Border Background="{DynamicResource BorderBrush}" Height="50" Width="50">
                            <hc:GeometryView Geometry="Invalid Geometry String"/>
                        </Border>
                    </StackPanel>
                </GroupBox>

                <!-- 描边示例 -->
                <GroupBox Header="描边示例" hc:BorderElement.CornerRadius="4">
                    <StackPanel Margin="16">
                        <TextBlock Text="无描边" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <hc:GeometryView Height="64" Width="64"
                                        Geometry="M 24,2 A 22,22 0 0,1 24,46 A 22,22 0 0,1 24,2 Z"
                                        Foreground="{DynamicResource PrimaryBrush}"/>
                        
                        <Separator Margin="0,16,0,8"/>
                        
                        <TextBlock Text="有描边（蓝色描边）" FontSize="14" FontWeight="SemiBold" Margin="0,8,0,8"/>
                        <hc:GeometryView Height="64" Width="64"
                                        Geometry="M 24,2 A 22,22 0 0,1 24,46 A 22,22 0 0,1 24,2 Z"
                                        Foreground="{DynamicResource PrimaryBrush}"
                                        Stroke="{DynamicResource DangerBrush}"
                                        StrokeThickness="2"/>
                    </StackPanel>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>
    </hc:TransitioningContentControl>
</UserControl>
