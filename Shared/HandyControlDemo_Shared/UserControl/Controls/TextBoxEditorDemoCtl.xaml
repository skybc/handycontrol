<UserControl x:Class="HandyControlDemo.UserControl.TextBoxEditorDemoCtl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             Background="{DynamicResource RegionBrush}">
    <hc:TransitioningContentControl>
        <hc:ScrollViewer IsInertiaEnabled="True">
            <hc:UniformSpacingPanel Spacing="32" Margin="32" ChildWrapping="Wrap">
                <StackPanel Width="400">
                    <TextBlock Text="TextBoxEditor 高级文本编辑器" 
                              Style="{StaticResource TextBlockTitle}" 
                              Margin="0,0,0,16"/>
                    
                    <hc:TextBoxEditor x:Name="TextBoxEditor1"
                                     hc:InfoElement.Title="模板文本"
                                     hc:InfoElement.TitlePlacement="Left"
                                     hc:InfoElement.TitleWidth="100"
                                     Text="{Binding EditorText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Variables="{Binding Variables}"
                                     Margin="0,0,0,16"/>

                    <hc:TextBoxEditor x:Name="TextBoxEditor2"
                                     hc:InfoElement.Title="消息模板"
                                     hc:InfoElement.Necessary="True"
                                     Text="{Binding MessageTemplate, Mode=TwoWay}"
                                     Variables="{Binding Variables}"
                                     Margin="0,16,0,0"/>

                    <hc:Divider Margin="0,32,0,16"/>

                    <TextBlock Text="编辑结果预览：" 
                              FontWeight="Bold" 
                              Margin="0,0,0,8"/>
                    
                    <Border BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource DefaultCornerRadius}"
                            Background="{DynamicResource SecondaryRegionBrush}"
                            Padding="10"
                            MinHeight="80">
                        <TextBlock Text="{Binding EditorText}" 
                                  TextWrapping="Wrap"
                                  VerticalAlignment="Top"/>
                    </Border>
                </StackPanel>

                <StackPanel Width="400">
                    <TextBlock Text="可用变量列表" 
                              Style="{StaticResource TextBlockTitle}" 
                              Margin="0,0,0,16"/>

                    <ItemsControl ItemsSource="{Binding Variables}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{DynamicResource BorderBrush}"
                                       BorderThickness="1"
                                       CornerRadius="{StaticResource DefaultCornerRadius}"
                                       Background="{DynamicResource RegionBrush}"
                                       Padding="8,4"
                                       Margin="0,4">
                                    <TextBlock Text="{Binding}" FontFamily="Consolas"/>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <hc:Divider Margin="0,32,0,16"/>

                    <TextBlock Text="使用说明：" 
                              FontWeight="Bold" 
                              Margin="0,0,0,8"/>
                    <TextBlock TextWrapping="Wrap" 
                              Foreground="{DynamicResource SecondaryTextBrush}">
                        1. 点击文本框右侧的"..."按钮打开编辑器<LineBreak/>
                        2. 在编辑器中输入文本内容<LineBreak/>
                        3. 双击右侧变量列表中的变量插入到光标位置<LineBreak/>
                        4. 变量格式为 {变量名}<LineBreak/>
                        5. 点击"确定"保存编辑结果
                    </TextBlock>
                </StackPanel>
            </hc:UniformSpacingPanel>
        </hc:ScrollViewer>
    </hc:TransitioningContentControl>
</UserControl>
