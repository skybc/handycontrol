<UserControl
    x:Class="HandyControlDemo.UserControl.PropertyGridDemoCtl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    Background="{DynamicResource RegionBrush}"
    DataContext="{Binding RelativeSource={RelativeSource Self}}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,16">
            <TextBlock
                FontSize="22"
                FontWeight="SemiBold"
                Foreground="{DynamicResource PrimaryTextBrush}"
                Text="属性编辑器性能对比" />
            <TextBlock
                Margin="0,6,0,0"
                Foreground="{DynamicResource SecondaryTextBrush}"
                Text="1000 个 CLR 属性 · 相同对象 · 独立测量加载与首帧等待" />
        </StackPanel>
        <WrapPanel Grid.Row="1" Margin="0,0,0,16">
            <Button
                Margin="0,0,8,8"
                Padding="14,6"
                Click="OnUpdateSameType"
                Content="切换同类型实例" />
            <Button
                Margin="0,0,8,8"
                Padding="14,6"
                Click="OnSwitchDifferentType"
                Content="切换不同类型" />
            <Button
                Margin="0,0,8,8"
                Padding="14,6"
                Click="OnRestoreDefault"
                Content="恢复 1000 属性对象" />
            <Button
                Margin="0,0,8,8"
                Padding="14,6"
                Click="OnMultiSelection"
                Content="多对象编辑测试" />
            <Button
                Margin="0,0,8,8"
                Padding="14,6"
                Click="OnShowMultiSelection"
                Content="查看多对象结果" />
            <Button
                Margin="0,0,8,8"
                Padding="14,6"
                Click="OnCustomEditorTest"
                Content="单对象自定义控件" />
            <Button
                Margin="0,0,8,8"
                Padding="14,6"
                Click="OnCustomMultiTest"
                Content="多对象自定义控件" />
            <Button
                Margin="0,0,8,8"
                Padding="14,6"
                Click="OnShowCustomResults"
                Content="查看自定义控件结果" />
        </WrapPanel>
        <Grid Grid.Row="2" MinHeight="280">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="16" />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <Border
                Padding="12"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="6">
                <DockPanel>
                    <StackPanel Margin="0,0,0,12" DockPanel.Dock="Top">
                        <TextBlock
                            FontSize="16"
                            FontWeight="SemiBold"
                            Text="PropertyGrid" />
                        <TextBlock
                            Margin="0,4,0,8"
                            Foreground="{DynamicResource SecondaryTextBrush}"
                            Text="现有控件" />
                        <Border
                            Padding="10"
                            Background="{DynamicResource SecondaryRegionBrush}"
                            CornerRadius="4">
                            <TextBlock
                                x:Name="LegacyTiming"
                                LineHeight="22"
                                Text="等待测量"
                                TextWrapping="Wrap" />
                        </Border>
                    </StackPanel>
                    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                        <hc:PropertyGrid x:Name="LegacyGrid" />
                    </ScrollViewer>
                </DockPanel>
            </Border>
            <Border
                Grid.Column="2"
                Padding="12"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="6">
                <DockPanel>
                    <StackPanel Margin="0,0,0,12" DockPanel.Dock="Top">
                        <TextBlock
                            FontSize="16"
                            FontWeight="SemiBold"
                            Text="FastPropertyGrid" />
                        <TextBlock
                            Margin="0,4,0,8"
                            Foreground="{DynamicResource SecondaryTextBrush}"
                            Text="虚拟化与编辑器复用" />
                        <Border
                            Padding="10"
                            Background="{DynamicResource SecondaryRegionBrush}"
                            CornerRadius="4">
                            <TextBlock
                                x:Name="FastTiming"
                                LineHeight="22"
                                Text="等待测量"
                                TextWrapping="Wrap" />
                        </Border>
                    </StackPanel>
                    <hc:FastPropertyGrid x:Name="FastGrid" />
                </DockPanel>
            </Border>
        </Grid>
        <TextBlock
            Grid.Row="3"
            Margin="0,12,0,0"
            Foreground="{DynamicResource SecondaryTextBrush}"
            Text="加载：设置选择对象的同步耗时。首帧等待：加载结束至 WPF Rendering 回调，包含布局与调度等待。"
            TextWrapping="Wrap" />
    </Grid>
</UserControl>
