<UserControl
    x:Class="HandyControlDemo.UserControl.PropertyGridDemoCtl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    Background="{DynamicResource RegionBrush}"
    DataContext="{Binding RelativeSource={RelativeSource Self}}">
    <hc:TransitioningContentControl>
        <Grid Margin="22">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <ScrollViewer Height="400">
                <hc:PropertyGrid Width="500" SelectedObject="{Binding DemoModel}" />
            </ScrollViewer>
            <StackPanel
                Grid.Row="1"
                Margin="20,16,17,10"
                hc:TitleElement.TitleWidth="168">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                    <Button Content="更新同类型对象" Click="OnUpdateSameType" Width="120" Margin="0,0,12,0" />
                    <Button Content="切换到不同类型" Click="OnSwitchDifferentType" Width="120" Margin="0,0,12,0" />
                    <Button Content="恢复默认对象" Click="OnRestoreDefault" Width="120" />
                </StackPanel>
                <TextBox
                    hc:TitleElement.Title="String"
                    hc:TitleElement.TitlePlacement="Left"
                    IsReadOnly="True"
                    Style="{StaticResource TextBoxExtend}"
                    Text="{Binding DemoModel.String, Mode=OneWay}" />
                <TextBox
                    Margin="0,6,0,0"
                    hc:TitleElement.Title="Enum"
                    hc:TitleElement.TitlePlacement="Left"
                    IsReadOnly="True"
                    Style="{StaticResource TextBoxExtend}"
                    Text="{Binding DemoModel.Enum, Mode=OneWay}" />
                <TextBox
                    Margin="0,6,0,0"
                    hc:TitleElement.Title="Integer"
                    hc:TitleElement.TitlePlacement="Left"
                    IsReadOnly="True"
                    Style="{StaticResource TextBoxExtend}"
                    Text="{Binding DemoModel.Integer, Mode=OneWay}" />
                <TextBox
                    Margin="0,6,0,0"
                    hc:TitleElement.Title="Boolean"
                    hc:TitleElement.TitlePlacement="Left"
                    IsReadOnly="True"
                    Style="{StaticResource TextBoxExtend}"
                    Text="{Binding DemoModel.Boolean, Mode=OneWay}" />
                <TextBox
                    Margin="0,6,0,0"
                    hc:TitleElement.Title="HorizontalAlignment"
                    hc:TitleElement.TitlePlacement="Left"
                    IsReadOnly="True"
                    Style="{StaticResource TextBoxExtend}"
                    Text="{Binding DemoModel.HorizontalAlignment, Mode=OneWay}" />
                <TextBox
                    Margin="0,6,0,0"
                    hc:TitleElement.Title="VerticalAlignment"
                    hc:TitleElement.TitlePlacement="Left"
                    IsReadOnly="True"
                    Style="{StaticResource TextBoxExtend}"
                    Text="{Binding DemoModel.VerticalAlignment, Mode=OneWay}" />
                <GroupBox
                    Margin="0,6,0,0"
                    hc:TitleElement.TitlePlacement="Left"
                    Header="ImageSource"
                    Style="{StaticResource GroupBoxOriginal}">
                    <hc:Gravatar HorizontalAlignment="Left" Source="{Binding DemoModel.ImageSource}" />
                </GroupBox>
            </StackPanel>
        </Grid>
    </hc:TransitioningContentControl>
</UserControl>
