<UserControl x:Class="HandyControlDemo.UserControl.StandardLightPaletteDemoCtl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             Background="{DynamicResource BackgroundBrush}">
    <UserControl.Resources>
        <Style x:Key="PaletteSectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TitleTextBrush}" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>
        <Style x:Key="PaletteColorCard" TargetType="Border">
            <Setter Property="Width" Value="216" />
            <Setter Property="Height" Value="116" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="{DynamicResource RegionBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="ToolTip" Value="点击复制资源名" />
        </Style>
        <Style x:Key="PaletteStateCard" TargetType="Border">
            <Setter Property="Width" Value="270" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="{DynamicResource RegionBrush}" />
        </Style>
        <Style x:Key="PaletteSwatch" TargetType="Border">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="ToolTip" Value="点击复制资源名" />
        </Style>
    </UserControl.Resources>

    <hc:ScrollViewer IsInertiaEnabled="True" Padding="32">
        <StackPanel MaxWidth="1160" HorizontalAlignment="Center">
            <Border Background="{DynamicResource RegionBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="24"
                    Margin="0,0,0,24">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="StandardLight 颜色规范" FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource TitleTextBrush}" />
                        <TextBlock Text="基础色、状态色和深色导航资源的实时预览" Margin="0,8,0,0" Foreground="{DynamicResource SecondaryTextBrush}" />
                    </StackPanel>
                    <Border Grid.Column="1" Background="{DynamicResource LightPrimaryBrush}" CornerRadius="16" Padding="12,5" VerticalAlignment="Center">
                        <TextBlock Text="Semantic tokens" Foreground="{DynamicResource DarkPrimaryBrush}" FontWeight="SemiBold" />
                    </Border>
                </Grid>
            </Border>

            <TextBlock Text="基础色" Style="{StaticResource PaletteSectionTitle}" />
            <hc:UniformSpacingPanel ChildWrapping="Wrap" ItemWidth="216" Spacing="12" Margin="0,0,0,28">
                <Border Style="{StaticResource PaletteColorCard}" Tag="BackgroundColor"><Grid><Border Background="{DynamicResource BackgroundBrush}" CornerRadius="7,7,0,0" /><StackPanel VerticalAlignment="Bottom" Margin="14,0,14,12"><TextBlock Text="页面底" FontWeight="SemiBold" /><TextBlock Text="#F8FAFC · BackgroundColor" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" /></StackPanel></Grid></Border>
                <Border Style="{StaticResource PaletteColorCard}" Tag="RegionColor"><Grid><Border Background="{DynamicResource RegionBrush}" CornerRadius="7,7,0,0" /><StackPanel VerticalAlignment="Bottom" Margin="14,0,14,12"><TextBlock Text="卡片 / 内容区" FontWeight="SemiBold" /><TextBlock Text="#FFFFFF · RegionColor" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" /></StackPanel></Grid></Border>
                <Border Style="{StaticResource PaletteColorCard}" Tag="SecondaryRegionColor"><Grid><Border Background="{DynamicResource SecondaryRegionBrush}" CornerRadius="7,7,0,0" /><StackPanel VerticalAlignment="Bottom" Margin="14,0,14,12"><TextBlock Text="表头 / 工具条" FontWeight="SemiBold" /><TextBlock Text="#F1F5F9 · SecondaryRegionColor" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" /></StackPanel></Grid></Border>
                <Border Style="{StaticResource PaletteColorCard}" Tag="BorderColor"><Grid><Border Background="{DynamicResource BorderBrush}" CornerRadius="7,7,0,0" Height="54" VerticalAlignment="Top" /><StackPanel VerticalAlignment="Bottom" Margin="14,0,14,12"><TextBlock Text="分隔线" FontWeight="SemiBold" /><TextBlock Text="#E2E8F0 · BorderColor" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" /></StackPanel></Grid></Border>
                <Border Style="{StaticResource PaletteColorCard}" Tag="SecondaryBorderColor"><Grid><Border Background="{DynamicResource SecondaryBorderBrush}" CornerRadius="7,7,0,0" Height="54" VerticalAlignment="Top" /><StackPanel VerticalAlignment="Bottom" Margin="14,0,14,12"><TextBlock Text="输入框边框" FontWeight="SemiBold" /><TextBlock Text="#CBD5E1 · SecondaryBorderColor" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" /></StackPanel></Grid></Border>
                <Border Style="{StaticResource PaletteColorCard}" Tag="DisabledColor"><Grid><Border Background="{DynamicResource DisabledBrush}" CornerRadius="7,7,0,0" Height="54" VerticalAlignment="Top" /><StackPanel VerticalAlignment="Bottom" Margin="14,0,14,12"><TextBlock Text="占位符 / 禁用" FontWeight="SemiBold" /><TextBlock Text="#94A3B8 · DisabledColor" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" /></StackPanel></Grid></Border>
                <Border Style="{StaticResource PaletteColorCard}" Tag="SecondaryTextColor"><Grid><Border Background="{DynamicResource SecondaryTextBrush}" CornerRadius="7,7,0,0" Height="54" VerticalAlignment="Top" /><StackPanel VerticalAlignment="Bottom" Margin="14,0,14,12"><TextBlock Text="辅助文字" FontWeight="SemiBold" /><TextBlock Text="#64748B · SecondaryTextColor" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" /></StackPanel></Grid></Border>
                <Border Style="{StaticResource PaletteColorCard}" Tag="PrimaryTextColor"><Grid><Border Background="{DynamicResource PrimaryTextBrush}" CornerRadius="7,7,0,0" Height="54" VerticalAlignment="Top" /><StackPanel VerticalAlignment="Bottom" Margin="14,0,14,12"><TextBlock Text="正文" FontWeight="SemiBold" /><TextBlock Text="#334155 · PrimaryTextColor" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" /></StackPanel></Grid></Border>
                <Border Style="{StaticResource PaletteColorCard}" Tag="TitleTextColor"><Grid><Border Background="{DynamicResource TitleTextBrush}" CornerRadius="7,7,0,0" Height="54" VerticalAlignment="Top" /><StackPanel VerticalAlignment="Bottom" Margin="14,0,14,12"><TextBlock Text="标题" FontWeight="SemiBold" /><TextBlock Text="#0F172A · TitleTextColor" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" /></StackPanel></Grid></Border>
            </hc:UniformSpacingPanel>

            <TextBlock Text="状态色" Style="{StaticResource PaletteSectionTitle}" />
            <hc:UniformSpacingPanel ChildWrapping="Wrap" ItemWidth="270" Spacing="12" Margin="0,0,0,28">
                <Border Style="{StaticResource PaletteStateCard}"><StackPanel><Border Background="{DynamicResource LightPrimaryBrush}" Padding="14,10" CornerRadius="7,7,0,0"><TextBlock Text="主色 / 选中  #EFF6FF" Foreground="{DynamicResource DarkPrimaryBrush}" FontWeight="SemiBold" /></Border><Grid Margin="14,12"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="88" /></Grid.ColumnDefinitions><TextBlock Text="#1D4ED8" Foreground="{DynamicResource DarkPrimaryBrush}" VerticalAlignment="Center" /><Border Grid.Column="1" Background="{DynamicResource PrimaryBrush}" CornerRadius="4" Padding="8,5"><TextBlock Text="#2563EB" Foreground="White" FontSize="11" HorizontalAlignment="Center" /></Border></Grid></StackPanel></Border>
                <Border Style="{StaticResource PaletteStateCard}"><StackPanel><Border Background="{DynamicResource LightSuccessBrush}" Padding="14,10" CornerRadius="7,7,0,0"><TextBlock Text="正常运行  #ECFDF5" Foreground="{DynamicResource DarkSuccessBrush}" FontWeight="SemiBold" /></Border><Grid Margin="14,12"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="88" /></Grid.ColumnDefinitions><TextBlock Text="#047857" Foreground="{DynamicResource DarkSuccessBrush}" VerticalAlignment="Center" /><Border Grid.Column="1" Background="{DynamicResource SuccessBrush}" CornerRadius="4" Padding="8,5"><TextBlock Text="#059669" Foreground="White" FontSize="11" HorizontalAlignment="Center" /></Border></Grid></StackPanel></Border>
                <Border Style="{StaticResource PaletteStateCard}"><StackPanel><Border Background="{DynamicResource LightWarningBrush}" Padding="14,10" CornerRadius="7,7,0,0"><TextBlock Text="警告  #FFFBEB" Foreground="{DynamicResource DarkWarningBrush}" FontWeight="SemiBold" /></Border><Grid Margin="14,12"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="88" /></Grid.ColumnDefinitions><TextBlock Text="#B45309" Foreground="{DynamicResource DarkWarningBrush}" VerticalAlignment="Center" /><Border Grid.Column="1" Background="{DynamicResource WarningBrush}" CornerRadius="4" Padding="8,5"><TextBlock Text="#F59E0B" Foreground="White" FontSize="11" HorizontalAlignment="Center" /></Border></Grid></StackPanel></Border>
                <Border Style="{StaticResource PaletteStateCard}"><StackPanel><Border Background="{DynamicResource LightDangerBrush}" Padding="14,10" CornerRadius="7,7,0,0"><TextBlock Text="故障 / 危险  #FEF2F2" Foreground="{DynamicResource DarkDangerBrush}" FontWeight="SemiBold" /></Border><Grid Margin="14,12"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="88" /></Grid.ColumnDefinitions><TextBlock Text="#B91C1C" Foreground="{DynamicResource DarkDangerBrush}" VerticalAlignment="Center" /><Border Grid.Column="1" Background="{DynamicResource DangerBrush}" CornerRadius="4" Padding="8,5"><TextBlock Text="#DC2626" Foreground="White" FontSize="11" HorizontalAlignment="Center" /></Border></Grid></StackPanel></Border>
                <Border Style="{StaticResource PaletteStateCard}"><StackPanel><Border Background="{DynamicResource LightInfoBrush}" Padding="14,10" CornerRadius="7,7,0,0"><TextBlock Text="进行中  #ECFEFF" Foreground="{DynamicResource DarkInfoBrush}" FontWeight="SemiBold" /></Border><Grid Margin="14,12"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="88" /></Grid.ColumnDefinitions><TextBlock Text="#0E7490" Foreground="{DynamicResource DarkInfoBrush}" VerticalAlignment="Center" /><Border Grid.Column="1" Background="{DynamicResource InfoBrush}" CornerRadius="4" Padding="8,5"><TextBlock Text="#0891B2" Foreground="White" FontSize="11" HorizontalAlignment="Center" /></Border></Grid></StackPanel></Border>
                <Border Style="{StaticResource PaletteStateCard}"><StackPanel><Border Background="{DynamicResource LightDisabledBrush}" Padding="14,10" CornerRadius="7,7,0,0"><TextBlock Text="未启用 / 无数据  #F1F5F9" Foreground="{DynamicResource DarkDisabledBrush}" FontWeight="SemiBold" /></Border><Grid Margin="14,12"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="88" /></Grid.ColumnDefinitions><TextBlock Text="#64748B" Foreground="{DynamicResource DarkDisabledBrush}" VerticalAlignment="Center" /><Border Grid.Column="1" Background="{DynamicResource DisabledBrush}" CornerRadius="4" Padding="8,5"><TextBlock Text="#94A3B8" Foreground="White" FontSize="11" HorizontalAlignment="Center" /></Border></Grid></StackPanel></Border>
            </hc:UniformSpacingPanel>

            <TextBlock Text="深色导航" Style="{StaticResource PaletteSectionTitle}" />
            <Border Background="{DynamicResource NavigationBackgroundBrush}" CornerRadius="10" Padding="20" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="180" /><ColumnDefinition Width="1" /><ColumnDefinition /></Grid.ColumnDefinitions>
                    <StackPanel><TextBlock Text="NAVIGATION" Foreground="{DynamicResource NavigationForegroundBrush}" FontWeight="SemiBold" /><TextBlock Text="#0F172A" Foreground="{DynamicResource NavigationForegroundBrush}" Opacity="0.7" Margin="0,4,0,0" /></StackPanel>
                    <Border Grid.Column="1" Background="{DynamicResource NavigationSeparatorBrush}" Margin="16,0" />
                    <StackPanel Grid.Column="2"><TextBlock Text="前景 #CBD5E1 · 分隔 #334155" Foreground="{DynamicResource NavigationForegroundBrush}" /><TextBlock Text="Dashboard     Devices     Alerts     Settings" Foreground="{DynamicResource NavigationForegroundBrush}" Opacity="0.75" Margin="0,8,0,0" /></StackPanel>
                </Grid>
            </Border>
        </StackPanel>
    </hc:ScrollViewer>
</UserControl>
